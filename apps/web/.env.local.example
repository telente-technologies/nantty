# NEXT_PUBLIC_* values are shipped to the browser. Public values only.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3500
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3200
NEXT_PUBLIC_ADS_MANAGER_URL=http://localhost:3300
NEXT_PUBLIC_PRELAUNCH_MODE=true
NEXT_PUBLIC_WAITLIST_APPS_SCRIPT_URL=
NEXT_PUBLIC_WAITLIST_ENABLED=false

# Company email domain (docs/emailAddresses.md). Addresses default to <name>@NEXT_PUBLIC_MAIL_DOMAIN.
NEXT_PUBLIC_MAIL_DOMAIN=nantty.com
# Store badges link here once the apps are live; empty shows the official badges marked "Coming soon".
NEXT_PUBLIC_APP_STORE_ID=
NEXT_PUBLIC_PLAY_PACKAGE=
