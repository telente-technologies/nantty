{
  "name": "@zudomart/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "zudojs": {
    "projectType": "backend",
    "architecture": "modular-monolith",
    "features": [
      "cqrs",
      "messaging",
      "observability",
      "openapi",
      "database",
      "queue",
      "events",
      "security",
      "redis",
      "cache",
      "storage",
      "websockets",
      "email",
      "scheduler",
      "docker"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "prisma generate && vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "start:production": "prisma migrate deploy && node dist/server.js",
    "lint": "eslint -c ../../packages/eslintConfig/node.config.mjs src"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/server": "^14.0.3",
    "@zudojs/auth": "^1.4.0",
    "@zudojs/cache": "^1.2.4",
    "@zudojs/config": "^1.3.4",
    "@zudojs/constants": "^1.2.0",
    "@zudojs/container": "^1.3.0",
    "@zudojs/core": "^1.3.0",
    "@zudojs/cqrs": "^1.3.0",
    "@zudojs/crypto": "^1.4.0",
    "@zudojs/database": "^1.5.0",
    "@zudojs/errors": "^1.4.0",
    "@zudojs/events": "^1.4.0",
    "@zudojs/http": "^1.5.0",
    "@zudojs/logger": "^1.5.0",
    "@zudojs/messaging": "^1.2.4",
    "@zudojs/middleware": "^1.1.3",
    "@zudojs/observability": "^1.3.0",
    "@zudojs/openapi": "^1.6.0",
    "@zudojs/queue": "^1.6.0",
    "@zudojs/runtime": "^1.4.0",
    "@zudojs/scheduler": "^1.3.0",
    "@zudojs/schema": "^1.3.0",
    "@zudojs/security": "^1.3.4",
    "@zudojs/storage": "^1.3.0",
    "@zudojs/types": "^1.3.0",
    "@zudojs/validation": "^1.2.0",
    "blurhash": "^2.0.5",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.10.0",
    "redis": "^6.2.1",
    "sharp": "^0.35.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@zudojs/testing": "^1.3.0",
    "@zudomart/eslint-config": "workspace:*",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
