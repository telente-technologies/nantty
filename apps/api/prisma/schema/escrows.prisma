model Escrow {
  id           String    @id @default(uuid())
  orderId      String    @unique
  paymentId    String
  storeId      String
  buyerId      String
  amount       BigInt
  currency     String
  status       String
  releaseAfter DateTime?
  heldAt       DateTime  @default(now())
  releasedAt   DateTime?
  refundedAt   DateTime?
  version      Int       @default(0)

  @@index([status, releaseAfter])
  @@index([storeId])
  @@map("escrows")
}

model Dispute {
  id           String    @id @default(uuid())
  escrowId     String
  orderId      String
  openedById   String
  reason       String
  details          String    @default("")
  evidenceMediaIds String[]  @default([])
  status           String    @default("open")
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([escrowId])
  @@map("disputes")
}

model DisputeMessage {
  id                 String   @id @default(uuid())
  disputeId          String
  authorId           String
  authorRole         String
  text               String
  attachmentMediaIds String[] @default([])
  createdAt          DateTime @default(now())

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}
