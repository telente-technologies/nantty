model SupportTicket {
  id                 String   @id @default(uuid())
  requesterId        String
  category           String
  subject            String
  status             String   @default("open")
  assigneeId         String?
  lastMessagePreview String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@index([requesterId, updatedAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id                 String   @id @default(uuid())
  ticketId           String
  authorId           String
  fromSupport        Boolean  @default(false)
  text               String
  attachmentMediaIds String[]
  createdAt          DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model SupportContactRequest {
  id              String   @id @default(uuid())
  kind            String
  name            String
  emailCiphertext String
  subject         String
  message         String
  requesterId     String?
  createdAt       DateTime @default(now())

  @@index([kind, createdAt])
  @@map("support_contact_requests")
}
