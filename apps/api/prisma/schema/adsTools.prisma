model AdCustomAudience {
  id             String   @id @default(uuid())
  accountId      String
  name           String
  type           String
  status         String   @default("building")
  sizeLower      Int?
  sizeUpper      Int?
  retentionDays  Int?
  description    String
  definition     Json
  matchedUserIds String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId])
  @@map("ad_custom_audiences")
}

model AdCustomerListHash {
  audienceId     String
  identifierHash String

  @@id([audienceId, identifierHash])
  @@map("ad_customer_list_hashes")
}

model AdAccountBillingSettings {
  accountId   String   @id
  fundingMode String   @default("prepaid")
  updatedAt   DateTime @updatedAt

  @@map("ad_account_billing_settings")
}

model AdTopUp {
  id              String    @id @default(uuid())
  accountId       String
  requestedById   String
  reference       String    @unique
  walletReference String    @unique
  amountMinor     BigInt
  currency        String
  provider        String
  status          String    @default("pending")
  failureReason   String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([accountId, createdAt])
  @@map("ad_top_ups")
}

model AdPaymentMethod {
  id                      String   @id @default(uuid())
  accountId               String
  requestedById           String
  provider                String
  reference               String   @unique
  status                  String   @default("pending")
  brand                   String   @default("Card")
  last4                   String   @default("0000")
  expMonth                Int      @default(12)
  expYear                 Int      @default(2030)
  isDefault               Boolean  @default(false)
  authorizationCiphertext String?
  createdAt               DateTime @default(now())

  @@index([accountId])
  @@map("ad_payment_methods")
}

model AdScheduledReport {
  id                   String   @id @default(uuid())
  accountId            String
  name                 String
  recipientsCiphertext String
  recipientCount       Int
  frequency            String
  breakdown            String
  metrics              String[]
  nextSendAt           DateTime
  createdById          String
  createdAt            DateTime @default(now())

  @@index([accountId])
  @@index([nextSendAt])
  @@map("ad_scheduled_reports")
}

model AdConversionEvent {
  id          String   @id @default(uuid())
  accountId   String
  name        String
  eventType   String
  storeId     String
  isBuiltIn   Boolean  @default(false)
  status      String   @default("active")
  tracksValue Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([accountId])
  @@map("ad_conversion_events")
}

model AdExperiment {
  id         String   @id @default(uuid())
  accountId  String
  name       String
  campaignId String
  variable   String
  metric     String
  status     String
  arms       Json
  startAt    DateTime
  endAt      DateTime
  result     Json?
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@map("ad_experiments")
}

model AdAutomatedRule {
  id                String    @id @default(uuid())
  accountId         String
  name              String
  status            String    @default("active")
  level             String
  targetIds         String[]
  conditions        Json
  action            Json
  checkEveryMinutes Int
  lastRunAt         DateTime?
  lastTriggeredAt   DateTime?
  triggerCount      Int       @default(0)
  createdAt         DateTime  @default(now())

  @@index([accountId])
  @@map("ad_automated_rules")
}
