model MediaUpload {
  id             String              @id @default(uuid())
  ownerId        String
  fileName       String
  mimeType       String
  purpose        String
  sizeBytes      Int
  chunkSizeBytes Int
  totalChunks    Int
  expectedSha256 String?
  status         String              @default("uploading")
  failureReason  String?
  mediaId        String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  chunks         MediaUploadChunk[]
  asset          MediaAsset?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@map("media_uploads")
}

model MediaUploadChunk {
  uploadId   String
  chunkIndex Int
  sizeBytes  Int
  sha256     String
  storageKey String
  createdAt  DateTime    @default(now())
  upload     MediaUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, chunkIndex])
  @@map("media_upload_chunks")
}

model MediaAsset {
  id                 String         @id @default(uuid())
  ownerId            String
  purpose            String
  type               String
  mimeType           String
  status             String         @default("processing")
  originalKey        String         @unique
  sizeBytes          Int
  sha256             String
  width              Int?
  height             Int?
  durationSeconds    Float?
  blurhash           String?
  posterKey          String?
  hlsMasterKey       String?
  failureReason      String?
  processingAttempts Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  readyAt            DateTime?
  variants           MediaVariant[]
  upload             MediaUpload?

  @@index([ownerId, createdAt])
  @@index([status, updatedAt])
  @@map("media_assets")
}

model MediaVariant {
  id          String     @id @default(uuid())
  assetId     String
  storageKey  String     @unique
  format      String
  contentType String
  width       Int
  height      Int
  sizeBytes   Int
  bitrateKbps Int?
  createdAt   DateTime   @default(now())
  asset       MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, format])
  @@map("media_variants")
}
