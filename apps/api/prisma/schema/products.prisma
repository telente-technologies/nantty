model Product {
  id             String    @id @default(uuid())
  storeId        String
  categoryId     String?
  title          String
  slug           String
  description    String    @default("")
  status         String    @default("draft")
  price          BigInt
  compareAtPrice BigInt?
  currency       String    @default("NGN")
  images         String[]
  shippingInfo   String    @default("")
  returnsInfo    String    @default("")
  featured       Boolean   @default(false)
  salesCount     Int       @default(0)
  ratingAvg      Float     @default(0)
  ratingCount    Int       @default(0)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([status, createdAt])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  sku       String?
  size      String?
  color     String?
  price     BigInt
  stock     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_variants")
}

model ProductLike {
  productId String
  userId    String
  createdAt DateTime @default(now())

  @@id([productId, userId])
  @@index([userId])
  @@map("product_likes")
}

model ProductBookmark {
  productId String
  userId    String
  createdAt DateTime @default(now())

  @@id([productId, userId])
  @@index([userId, createdAt])
  @@map("product_bookmarks")
}
