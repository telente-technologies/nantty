model Checkout {
  id        String   @id @default(uuid())
  buyerId   String
  total     BigInt
  currency  String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([buyerId])
  @@map("checkouts")
}

model Order {
  id              String      @id @default(uuid())
  number          String      @unique
  checkoutId      String
  buyerId         String
  storeId         String
  status          String
  currency        String
  itemsTotal      BigInt
  discountTotal   BigInt
  shippingTotal   BigInt
  total           BigInt
  chargeCurrency  String
  chargeTotal     BigInt
  exchangeRate    BigInt
  rateLockedAt    DateTime
  shippingAddress Json
  customerName    String      @default("")
  trackingNumber  String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([buyerId, createdAt])
  @@index([storeId, createdAt])
  @@index([checkoutId])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String
  productId         String
  variantId         String
  title             String
  size              String?
  color             String?
  imageUrl          String?
  unitPrice         BigInt
  quantity          Int
  lineTotal         BigInt
  attributionSource String?
  attributionId     String?
  order             Order   @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([attributionSource, attributionId])
  @@map("order_items")
}
