model PlatformStaffAccount {
  id                         String    @id @default(uuid())
  email                      String    @unique
  name                       String
  passwordHash               String?
  role                       String
  permissions                String[]
  status                     String    @default("INVITED")
  ipAllowList                String[]
  totpSecretEncrypted        String?
  pendingTotpSecretEncrypted String?
  totpEnabledAt              DateTime?
  totpLastUsedStep           Int?
  recoveryCodeHashes         String[]
  failedLoginCount           Int       @default(0)
  lockedUntil                DateTime?
  lastLoginAt                DateTime?
  createdById                String?
  disabledAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([role, status])
  @@map("platform_staff_accounts")
}

model PlatformStaffInvitation {
  id          String    @id @default(uuid())
  staffId     String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([staffId])
  @@map("platform_staff_invitations")
}

model PlatformStaffChallenge {
  id                String    @id @default(uuid())
  staffId           String
  tokenHash         String    @unique
  attempts          Int       @default(0)
  webAuthnChallenge String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([staffId])
  @@map("platform_staff_challenges")
}

model PlatformStaffSession {
  id                         String    @id
  staffId                    String
  refreshTokenHash           String
  ipAddress                  String?
  userAgent                  String?
  stepUpTokenHash            String?
  stepUpExpiresAt            DateTime?
  webAuthnChallenge          String?
  webAuthnChallengeExpiresAt DateTime?
  createdAt                  DateTime  @default(now())
  lastSeenAt                 DateTime  @default(now())
  expiresAt                  DateTime
  revokedAt                  DateTime?
  revokedReason              String?

  @@index([staffId])
  @@map("platform_staff_sessions")
}

model WebAuthnCredential {
  id           String    @id @default(uuid())
  staffId      String
  credentialId String    @unique
  publicKey    String
  signCount    Int       @default(0)
  transports   String[]
  label        String    @default("")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([staffId])
  @@map("webauthn_credentials")
}
