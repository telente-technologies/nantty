model IdempotencyRecord {
  id           String   @id @default(uuid())
  scope        String
  key          String
  requestHash  String
  status       String   @default("in_progress")
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([scope, key])
  @@map("idempotency_records")
}
