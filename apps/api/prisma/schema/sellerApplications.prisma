model SellerApplication {
  id          String    @id @default(uuid())
  userId      String
  storeName   String
  description String    @default("")
  categoryId  String?
  phoneEnc    String
  onboarding  Json?
  status      String    @default("pending")
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@map("seller_applications")
}
