model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  phone           String?   @unique
  username        String    @unique
  passwordHash    String?
  name            String    @default("")
  bio             String    @default("")
  avatarUrl       String?
  bannerUrl       String?
  birthday        DateTime? @db.Date
  roles           String[]
  status          String    @default("active")
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("users")
}

model Topic {
  id    String @id @default(uuid())
  slug  String @unique
  name  String
  order Int    @default(0)

  @@map("topics")
}

model UserTopic {
  userId  String
  topicId String

  @@id([userId, topicId])
  @@map("user_topics")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String   @default("")
  fullName   String
  phoneEnc   String
  line1      String
  line2      String   @default("")
  city       String
  state      String
  country    String   @default("NG")
  postalCode String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}
