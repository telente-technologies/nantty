model Notification {
  id        String    @id @default(uuid())
  userId    String
  category  String
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}
