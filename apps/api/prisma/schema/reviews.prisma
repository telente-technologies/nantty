model Review {
  id        String    @id @default(uuid())
  productId String
  storeId   String
  orderId   String
  userId    String
  rating    Int
  text      String    @default("")
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, orderId, productId])
  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@map("reviews")
}
