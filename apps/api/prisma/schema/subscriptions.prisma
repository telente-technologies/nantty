model SubscriptionPlan {
  id           String                        @id @default(uuid())
  color        String
  tier         String
  name         String
  description  String                        @default("")
  purchasable  Boolean                       @default(true)
  trialDays    Int                           @default(0)
  active       Boolean                       @default(true)
  sortOrder    Int                           @default(0)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  prices       SubscriptionPlanPrice[]
  entitlements SubscriptionPlanEntitlement[]
  perks        SubscriptionPlanPerk[]

  @@unique([color, tier])
  @@map("subscription_plans")
}

model SubscriptionPlanPrice {
  id       String           @id @default(uuid())
  planId   String
  interval String
  currency String
  amount   BigInt
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, interval, currency])
  @@map("subscription_plan_prices")
}

model SubscriptionPlanEntitlement {
  id     String           @id @default(uuid())
  planId String
  key    String
  value  Json
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("subscription_plan_entitlements")
}

model SubscriptionPlanPerk {
  id          String           @id @default(uuid())
  planId      String
  title       String
  description String           @default("")
  sortOrder   Int              @default(0)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("subscription_plan_perks")
}

model ProfileSubscription {
  id                     String    @id @default(uuid())
  profileId              String    @unique
  profileKind            String
  profileType            String
  ownerUserId            String
  plan                   String
  status                 String
  autoRenew              Boolean   @default(true)
  interval               String
  provider               String?
  currency               String?
  amount                 BigInt?
  authorizationEncrypted String?
  payerEmail             String?
  startsAt               DateTime
  endsAt                 DateTime?
  trialEndsAt            DateTime?
  trialUsed              Boolean   @default(false)
  pastDueSince           DateTime?
  cancelledAt            DateTime?
  lastChargeAttemptAt    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())

  @@index([status, endsAt])
  @@index([ownerUserId])
  @@map("profile_subscriptions")
}

model SubscriptionCharge {
  id                    String    @id @default(uuid())
  profileId             String
  profileKind           String
  profileType           String
  ownerUserId           String
  payerUserId           String
  plan                  String
  interval              String
  kind                  String
  reference             String    @unique
  provider              String
  amount                BigInt
  currency              String
  status                String    @default("pending")
  providerTransactionId String?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([profileId, createdAt])
  @@map("subscription_charges")
}
