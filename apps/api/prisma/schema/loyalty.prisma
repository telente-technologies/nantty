model LoyaltyReward {
  id          String   @id @default(uuid())
  userId      String
  kind        String
  reference   String   @unique
  points      Int      @default(0)
  amount      BigInt   @default(0)
  currency    String?
  orderId     String?
  description String   @default("")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("loyalty_rewards")
}

model PointsRedemption {
  checkoutId String   @id
  userId     String
  points     Int
  discount   BigInt
  currency   String
  status     String   @default("held")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("points_redemptions")
}

model ReferralCode {
  userId    String   @id
  code      String   @unique
  createdAt DateTime @default(now())

  @@map("referral_codes")
}

model Referral {
  id              String   @id @default(uuid())
  referrerId      String
  refereeId       String   @unique
  code            String
  status          String   @default("joined")
  rejectionReason String?
  rewardAmount    BigInt?
  rewardCurrency  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([referrerId, createdAt])
  @@map("referrals")
}

model CashbackPromo {
  id          String    @id @default(uuid())
  storeId     String?
  categoryId  String?
  rateBps     Int
  startsAt    DateTime
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())

  @@index([storeId])
  @@index([categoryId])
  @@map("cashback_promos")
}
