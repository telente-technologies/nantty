model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Follow {
  followerId   String
  followeeType String
  followeeId   String
  createdAt    DateTime @default(now())

  @@id([followerId, followeeType, followeeId])
  @@index([followeeType, followeeId])
  @@map("follows")
}
