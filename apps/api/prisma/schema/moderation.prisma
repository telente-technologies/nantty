model ModerationReport {
  id          String   @id @default(uuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  details     String   @default("")
  caseId      String
  status      String   @default("received")
  outcomeNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([caseId])
  @@index([reporterId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("moderation_reports")
}

model ModerationCase {
  id            String    @id @default(uuid())
  targetType    String
  targetId      String
  targetOwnerId String?
  targetSummary String    @default("")
  openKey       String?   @unique
  status        String    @default("open")
  priority      Int       @default(0)
  reportCount   Int       @default(0)
  source        String    @default("report")
  flaggedReason String?
  autoHidden    Boolean   @default(false)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())

  @@index([status, priority, createdAt])
  @@index([targetType, targetId])
  @@map("moderation_cases")
}

model ModerationDecision {
  id               String    @id @default(uuid())
  caseId           String
  targetType       String
  targetId         String
  affectedUserId   String?
  action           String
  reason           String
  actorId          String?
  suspensionEndsAt DateTime?
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([caseId])
  @@index([affectedUserId, createdAt])
  @@map("moderation_decisions")
}

model ModerationAppeal {
  id          String    @id @default(uuid())
  decisionId  String    @unique
  appellantId String
  statement   String
  status      String    @default("pending")
  reviewerId  String?
  reviewNote  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([appellantId])
  @@map("moderation_appeals")
}

model AccountSuspension {
  id         String    @id @default(uuid())
  userId     String
  decisionId String    @unique
  endsAt     DateTime?
  liftedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("account_suspensions")
}
