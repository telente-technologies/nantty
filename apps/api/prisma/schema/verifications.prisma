model ProfileVerification {
  id                     String    @id @default(uuid())
  profileId              String    @unique
  profileKind            String
  ownerUserId            String
  profileType            String
  verificationType       String
  color                  String
  status                 String
  tier                   String?
  badgeVisible           Boolean   @default(false)
  applicationSubmittedAt DateTime?
  reviewedAt             DateTime?
  reviewedById           String?
  reason                 String?
  details                Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())

  @@index([status, verificationType])
  @@index([ownerUserId])
  @@map("profile_verifications")
}
