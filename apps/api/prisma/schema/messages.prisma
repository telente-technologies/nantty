model Conversation {
  id                          String   @id @default(uuid())
  kind                        String   @default("direct")
  pairKey                     String?  @unique
  title                       String?
  description                 String   @default("")
  photoMediaId                String?
  ownerId                     String?
  storeId                     String?
  disappearingMessagesSeconds Int?
  memberCount                 Int      @default(0)
  lastMessageAt               DateTime @default(now())
  createdAt                   DateTime @default(now())

  @@index([storeId, lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String
  role           String   @default("member")
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  @@id([conversationId, userId])
  @@index([userId])
  @@index([conversationId, joinedAt])
  @@map("conversation_participants")
}

model Message {
  id                   String    @id @default(uuid())
  conversationId       String
  senderId             String
  senderStoreId        String?
  kind                 String    @default("text")
  text                 String
  media                Json      @default("[]")
  voiceMediaId         String?
  voiceDurationSeconds Int?
  expiresAt            DateTime?
  hiddenAt             DateTime?
  createdAt            DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@index([voiceMediaId])
  @@map("messages")
}

model MessageReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model RealtimeTicket {
  id         String    @id @default(uuid())
  ticketHash String    @unique
  userId     String
  sessionId  String
  roles      String[]
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@map("realtime_tickets")
}
