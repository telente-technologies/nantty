model Store {
  id             String   @id @default(uuid())
  ownerId        String
  name           String
  slug           String   @unique
  description    String   @default("")
  logoUrl        String?
  bannerUrl      String?
  status         String   @default("active")
  featured       Boolean  @default(false)
  shippingPolicy String   @default("")
  returnPolicy   String   @default("")
  currency       String
  shippingFee    BigInt   @default(0)
  discountBps    Int      @default(0)
  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@map("stores")
}

model StoreMember {
  storeId   String
  userId    String
  role      String
  createdAt DateTime @default(now())

  @@id([storeId, userId])
  @@index([userId])
  @@map("store_members")
}
