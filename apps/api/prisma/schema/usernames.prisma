model UsernameChange {
  id               String   @id @default(uuid())
  userId           String
  previousUsername String
  newUsername      String
  reason           String
  changedById      String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@map("username_changes")
}

model UsernameHold {
  username      String    @id
  kind          String
  heldForUserId String?
  reason        String
  note          String    @default("")
  createdById   String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([kind, createdAt])
  @@map("username_holds")
}

model ReservedUsername {
  id          String   @id @default(uuid())
  term        String   @unique
  matchKind   String
  reason      String   @default("")
  createdById String?
  createdAt   DateTime @default(now())

  @@map("reserved_usernames")
}
