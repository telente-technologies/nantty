model AutomationRule {
  id                   String   @id @default(uuid())
  name                 String
  description          String   @default("")
  trigger              String
  conditions           Json     @default("[]")
  actions              Json     @default("[]")
  threshold            Json?
  cooldownSeconds      Int?
  maxExecutionsPerHour Int      @default(60)
  enabled              Boolean  @default(true)
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now())

  @@index([trigger, enabled])
  @@map("automation_rules")
}

model AutomationExecution {
  id         String   @id @default(uuid())
  ruleId     String
  trigger    String
  subjectKey String
  status     String
  steps      Json     @default("[]")
  input      Json     @default("{}")
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime @default(now())

  @@index([ruleId, startedAt])
  @@index([ruleId, subjectKey, status])
  @@map("automation_executions")
}

model AutomationEventOccurrence {
  id         String   @id @default(uuid())
  trigger    String
  subjectKey String
  occurredAt DateTime @default(now())

  @@index([trigger, subjectKey, occurredAt])
  @@map("automation_event_occurrences")
}
