model AdAccount {
  id                     String   @id @default(uuid())
  name                   String
  kind                   String
  ownerId                String
  storeId                String?  @unique
  countryCode            String
  currency               String
  timezone               String
  status                 String   @default("active")
  disabledReason         String?
  monthlySpendLimitMinor BigInt?
  violationCount         Int       @default(0)
  lastViolationAt        DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([ownerId])
  @@map("ad_accounts")
}

model AdAccountMember {
  accountId    String
  userId       String
  role         String
  addedAt      DateTime  @default(now())
  lastActiveAt DateTime?

  @@id([accountId, userId])
  @@index([userId])
  @@map("ad_account_members")
}

model AdAccountInvite {
  id              String   @id @default(uuid())
  accountId       String
  emailHash       String
  emailCiphertext String
  role            String
  invitedById     String
  tokenHash       String   @unique
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([accountId, status])
  @@map("ad_account_invites")
}

model AdActivity {
  id         String   @id @default(uuid())
  accountId  String
  actorId    String?
  actorLabel String
  objectType String
  objectId   String
  summary    String
  changes    Json     @default("[]")
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("ad_activities")
}

model AdCampaign {
  id            String    @id @default(uuid())
  accountId     String
  name          String
  objective     String
  status        String    @default("draft")
  budgetLevel   String
  budgetType    String?
  budgetMinor   BigInt?
  spendCapMinor BigInt?
  currency      String
  startAt       DateTime
  endAt         DateTime?
  origin        String    @default("ads_manager")
  prepaid       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([accountId, status])
  @@index([status])
  @@map("ad_campaigns")
}

model AdSet {
  id                   String    @id @default(uuid())
  accountId            String
  campaignId           String
  name                 String
  status               String    @default("draft")
  audience             Json
  placementMode        String
  placements           String[]
  startAt              DateTime
  endAt                DateTime?
  budgetType           String?
  budgetMinor          BigInt?
  bidType              String
  bidMinor             BigInt?
  frequencyImpressions Int?
  frequencyDays        Int?
  conversionEventId    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([campaignId])
  @@index([accountId])
  @@map("ad_sets")
}

model Ad {
  id                    String    @id @default(uuid())
  accountId             String
  campaignId            String
  adSetId               String
  name                  String
  status                String    @default("draft")
  reviewStatus          String    @default("not_submitted")
  policyCode            String?
  policyReason          String?
  reviewedAt            DateTime?
  reviewedById          String?
  appeal                Json?
  autoCheckFlags        Json      @default("[]")
  submittedAt           DateTime?
  creativeInput         Json
  creative              Json
  deliverablePlacements String[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([adSetId])
  @@index([campaignId])
  @@index([accountId])
  @@index([status, reviewStatus])
  @@map("ads")
}

model AdSpendCounter {
  scopeId     String
  period      String
  spentMilliMinor BigInt @default(0)

  @@id([scopeId, period])
  @@map("ad_spend_counters")
}

model AdServing {
  id               String   @id @default(uuid())
  auctionId        String
  accountId        String
  campaignId       String
  adSetId          String
  adId             String
  viewerId         String
  surface          String
  placement        String
  itemId           String
  hostContentId    String?
  hostCreatorId    String?
  chargeModel      String
  chargePriceMinor BigInt
  currency         String
  servedAt         DateTime @default(now())

  @@index([viewerId, campaignId, itemId, servedAt])
  @@map("ad_servings")
}

model AdEvent {
  id              String   @id @default(uuid())
  dedupeKey       String   @unique
  type            String
  servingId       String?
  accountId       String
  campaignId      String
  adSetId         String
  adId            String
  viewerId        String
  surface         String
  billed          Boolean  @default(false)
  chargeMilliMinor    BigInt   @default(0)
  currency        String
  rejectionReason String?
  orderId         String?
  valueMinor      BigInt?
  occurredAt      DateTime @default(now())

  @@index([campaignId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([viewerId, type, occurredAt])
  @@map("ad_events")
}

model AdBillingTransaction {
  id          String   @id @default(uuid())
  accountId   String
  type        String
  amountMinor BigInt
  currency    String
  description String
  reference   String   @unique
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("ad_billing_transactions")
}

model AdBoost {
  id               String    @id @default(uuid())
  userId           String
  postId           String
  accountId        String
  campaignId       String
  adId             String
  goal             String
  audience         Json
  dailyBudgetMinor BigInt
  durationDays     Int
  totalMinor       BigInt
  currency         String
  status           String
  chargeReference  String    @unique
  rejectionReason  String?
  startsAt         DateTime?
  endsAt           DateTime?
  refundedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("ad_boosts")
}

model AdPolicyCategory {
  id             String   @id
  name           String   @unique
  description    String
  severity       String
  isActive       Boolean  @default(true)
  rejectionCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("ad_policy_categories")
}
