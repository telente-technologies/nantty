model CreatorApplication {
  id          String    @id @default(uuid())
  userId      String
  status      String    @default("pending")
  eligibility Json      @default("{}")
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("creator_applications")
}

model CreatorProfile {
  userId           String    @id
  status           String    @default("approved")
  tier             String    @default("standard")
  approvedAt       DateTime
  suspendedAt      DateTime?
  suspensionReason String?
  updatedAt        DateTime  @updatedAt

  @@map("creator_profiles")
}

model CreatorViolation {
  id           String   @id @default(uuid())
  userId       String
  reason       String
  recordedById String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("creator_violations")
}

model CreatorEarning {
  id          String   @id @default(uuid())
  creatorId   String
  kind        String
  reference   String   @unique
  sourceType  String
  sourceId    String
  grossAmount BigInt
  netAmount   BigInt
  currency    String
  orderId     String?
  productId   String?
  createdAt   DateTime @default(now())

  @@index([creatorId, createdAt])
  @@index([creatorId, kind, createdAt])
  @@map("creator_earnings")
}

model LiveGift {
  id            String   @id @default(uuid())
  liveSessionId String
  senderId      String
  creatorId     String
  giftId        String
  quantity      Int
  amount        BigInt
  currency      String
  reference     String   @unique
  createdAt     DateTime @default(now())

  @@index([liveSessionId, createdAt])
  @@index([creatorId, createdAt])
  @@map("live_gifts")
}

model AffiliateCommission {
  id            String   @id @default(uuid())
  targetKey     String   @unique
  storeId       String
  productId     String?
  commissionBps Int
  updatedById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId])
  @@map("affiliate_commissions")
}

model CreatorAffiliation {
  creatorId String
  targetKey String
  storeId   String
  productId String?
  createdAt DateTime @default(now())

  @@id([creatorId, targetKey])
  @@map("creator_affiliations")
}

model BrandDeal {
  id         String    @id @default(uuid())
  creatorId  String
  brandName  String
  amount     BigInt
  currency   String
  startsAt   DateTime
  endsAt     DateTime?
  disclosure String
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([creatorId, createdAt])
  @@map("brand_deals")
}
