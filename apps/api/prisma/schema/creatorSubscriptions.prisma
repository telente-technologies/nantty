model CreatorSubscriptionPlan {
  id          String   @id @default(uuid())
  creatorId   String
  name        String
  description String   @default("")
  price       BigInt
  currency    String
  interval    String   @default("month")
  benefits    Json     @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId, createdAt])
  @@map("creator_subscription_plans")
}

model CreatorSubscription {
  id                     String    @id @default(uuid())
  subscriberId           String
  creatorId              String
  planId                 String
  status                 String    @default("pending")
  provider               String
  amount                 BigInt
  currency               String
  interval               String    @default("month")
  authorizationEncrypted String?
  payerEmail             String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([subscriberId, creatorId])
  @@index([creatorId, status])
  @@index([status, currentPeriodEnd])
  @@map("creator_subscriptions")
}

model CreatorSubscriptionCharge {
  id                    String    @id @default(uuid())
  subscriptionId        String
  subscriberId          String
  creatorId             String
  kind                  String
  reference             String    @unique
  provider              String
  amount                BigInt
  currency              String
  status                String    @default("pending")
  providerTransactionId String?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([subscriptionId, createdAt])
  @@map("creator_subscription_charges")
}
