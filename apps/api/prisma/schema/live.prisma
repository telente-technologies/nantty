model LiveSession {
  id            String    @id @default(uuid())
  hostId        String
  storeId       String?
  title         String
  status        String    @default("live")
  viewerCount   Int       @default(0)
  reactionCount Int       @default(0)
  productIds    String[]
  pinnedId      String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  @@index([status, startedAt])
  @@index([hostId, startedAt])
  @@map("live_sessions")
}

model LiveViewer {
  sessionId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@id([sessionId, userId])
  @@map("live_viewers")
}

model LiveComment {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("live_comments")
}
