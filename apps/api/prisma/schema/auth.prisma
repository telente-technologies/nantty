model AuthIdentity {
  id        String   @id @default(uuid())
  userId    String
  provider  String
  subject   String
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  @@index([userId])
  @@map("sessions")
}

model OtpCode {
  id         String    @id @default(uuid())
  target     String
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, purpose])
  @@map("otp_codes")
}
