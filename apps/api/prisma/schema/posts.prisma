model Post {
  id           String    @id @default(uuid())
  authorId     String
  storeId      String?
  kind         String    @default("post")
  text         String    @default("")
  media        Json      @default("[]")
  audience     String    @default("everyone")
  topics       String[]
  productIds   String[]
  repostOfId   String?
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  repostCount  Int       @default(0)
  shareCount   Int       @default(0)
  viewCount    Int       @default(0)
  expiresAt    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([authorId, createdAt])
  @@index([kind, createdAt])
  @@map("posts")
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model Comment {
  id              String    @id @default(uuid())
  postId          String
  authorId        String
  parentCommentId String?   @map("parentId")
  rootCommentId   String?
  text            String
  likeCount       Int       @default(0)
  replyCount      Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  parentComment   Comment?  @relation("CommentParent", fields: [parentCommentId], references: [id])
  directReplies   Comment[] @relation("CommentParent")
  rootComment     Comment?  @relation("CommentRoot", fields: [rootCommentId], references: [id])
  threadReplies   Comment[] @relation("CommentRoot")

  @@index([postId, createdAt])
  @@index([postId, parentCommentId, createdAt])
  @@index([rootCommentId, createdAt])
  @@map("comments")
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model StoryView {
  storyId String
  userId  String
  seenAt  DateTime @default(now())

  @@id([storyId, userId])
  @@index([userId])
  @@map("story_views")
}
