model AuditEvent {
  id             String   @id @default(uuid())
  actorId        String?
  actorKind      String   @default("USER")
  actorName      String   @default("")
  actorRole      String?
  action         String
  area           String   @default("")
  entityType     String
  entityId       String
  targetLabel    String   @default("")
  reason         String   @default("")
  metadata       Json     @default("{}")
  before         Json?
  after          Json?
  ip             String?
  requestId      String?
  stepUpVerified Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([area, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}
