NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Comma-separated origins allowed to call the API from a browser (empty: none)
CORS_ORIGINS=
# Length of the rate-limit window in milliseconds
RATE_LIMIT_WINDOW_MS=60000
# Requests allowed per client per window; 0 disables the limit (load tests, local development)
RATE_LIMIT_MAX=1000
DATABASE_URL=postgresql://localhost:5432/zudomart
REDIS_URL=redis://localhost:6379
CACHE_MAX_ENTRIES=10000
CACHE_DEFAULT_TTL_MS=60000
STORAGE_DIRECTORY=./.data/storage
WEBSOCKET_PATH=/ws
# console (logs only) or smtp
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
# Issued by your SMTP provider; unused by the console transport and Mailpit
SMTP_PASSWORD=
# Password for the compose.yaml postgres service; generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Secrets ─────────────────────────────────────────────────────────────
# Never commit real values. Use a different value per environment; in
# production load them from a secret manager, not a file on disk.

# Auth tokens. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Short-lived access tokens; refresh tokens rotate on every use.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# One-time codes (login / password reset)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Field-level encryption for payout bank details and other PII at rest.
# 32 bytes, base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Payments. Use test keys outside production. Webhooks are rejected unless
# their signature verifies against these values.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Google sign-in (the client ID is public; the server verifies ID tokens against it)
GOOGLE_CLIENT_ID=

# Money: amounts are integers in minor units (kobo for NGN).
DEFAULT_CURRENCY=NGN
