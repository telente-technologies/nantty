NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Comma-separated origins allowed to call the API from a browser (empty: none)
CORS_ORIGINS=
# Seller dashboard web app (e.g. https://dashboard.zudomart.com; http://localhost:3200 in development)
DASHBOARD_ORIGIN=http://localhost:3200
# Ads Manager web app (e.g. https://ads.zudomart.com)
ADS_MANAGER_ORIGIN=http://localhost:3300
# Platform admin web app (e.g. https://admin.zudomart.com)
ADMIN_ORIGIN=http://localhost:3400
# Marketing/landing site (e.g. https://zudomart.com)
MARKETING_SITE_ORIGIN=http://localhost:3100
# Length of the rate-limit window in milliseconds
RATE_LIMIT_WINDOW_MS=60000
# Requests allowed per client per window; 0 disables the limit (load tests, local development)
RATE_LIMIT_MAX=1000
DATABASE_URL=postgresql://localhost:5432/zudomart
REDIS_URL=redis://localhost:6379
CACHE_MAX_ENTRIES=10000
CACHE_DEFAULT_TTL_MS=60000
STORAGE_DIRECTORY=./.data/storage
WEBSOCKET_PATH=/ws
# console (logs only) or smtp
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
# Issued by your SMTP provider; unused by the console transport and Mailpit
SMTP_PASSWORD=
# Password for the compose.yaml postgres service; generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Secrets ─────────────────────────────────────────────────────────────
# Never commit real values. Use a different value per environment; in
# production load them from a secret manager, not a file on disk.

# Auth tokens. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Short-lived access tokens; refresh tokens rotate on every use.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# One-time codes (login / password reset)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Stricter limit for login, OTP and password-reset endpoints (per client per window)
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=20

# Field-level encryption for payout bank details and other PII at rest.
# 32 bytes, base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Payments. Use test keys outside production. Webhooks are rejected unless
# their signature verifies against these values.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Where the provider sends the buyer after paying (the app deep link or web page)
PAYMENT_CALLBACK_URL=
# Allowed checkout return addresses (comma-separated); the first is the default. Clients pick one with returnTo.
PAYMENT_RETURN_URLS=zudomart://payments/return
# Days a past-due subscription keeps its entitlements before it expires
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Google sign-in (the client ID is public; the server verifies ID tokens against it)
GOOGLE_CLIENT_ID=
# Apple sign-in: the app's bundle ID / service ID (comma-separated if several)
APPLE_CLIENT_ID=

# Absolute origin of this API, used to build media URLs (empty: relative URLs)
PUBLIC_BASE_URL=
# Chunked uploads: chunk size and per-purpose size limits in bytes
MEDIA_CHUNK_SIZE_BYTES=5242880
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_MAX_PROFILE_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=209715200
MEDIA_MAX_KYC_BYTES=15728640
MEDIA_MAX_VOICE_BYTES=10485760
# Video duration limits in seconds, enforced after probing
MEDIA_MAX_CLIP_SECONDS=180
MEDIA_MAX_STORY_SECONDS=60
MEDIA_MAX_VIDEO_SECONDS=600
# Processing jobs: attempts, first retry delay (doubles each retry), parallel jobs
MEDIA_PROCESSING_MAX_ATTEMPTS=4
MEDIA_PROCESSING_BACKOFF_MS=5000
MEDIA_PROCESSING_CONCURRENCY=2
# Unfinished uploads older than this are deleted (e.g. 24h)
MEDIA_ABANDONED_UPLOAD_AFTER=24h
# ffmpeg/ffprobe binaries used for video processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Money: amounts are integers in minor units, always stored with their currency.
# Prices are shown in the viewer's local currency (unsupported countries see USD).
# Request header set by your CDN/proxy with the client's ISO country (e.g. cf-ipcountry).
# Leave empty unless a proxy you control sets it: clients could otherwise spoof it.
TRUSTED_COUNTRY_HEADER=
# static (built-in development rates) or open-exchange-rates-api (open.er-api.com)
EXCHANGE_RATE_PROVIDER=static
EXCHANGE_RATE_REFRESH_MINUTES=60
# Platform fee taken from each escrow release, in basis points (500 = 5%)
PLATFORM_COMMISSION_BPS=500
# Days a buyer has to confirm delivery or dispute before escrow auto-releases
ESCROW_INSPECTION_DAYS=3

# Creator Program eligibility and earnings
CREATOR_MIN_ACCOUNT_AGE_DAYS=30
CREATOR_REQUIRE_VERIFIED_EMAIL=true
# Public Blue verification tiers that qualify (comma-separated ESSENTIAL,VERIFIED,PREMIUM; empty = not required)
CREATOR_REQUIRED_BLUE_TIERS=VERIFIED,PREMIUM
CREATOR_MIN_FOLLOWERS=0
CREATOR_MIN_POSTS=0
CREATOR_VIOLATION_LOOKBACK_DAYS=90
LIVE_GIFT_PLATFORM_CUT_BPS=3000
AFFILIATE_MAX_COMMISSION_BPS=5000

# Intelligence service (apps/intelligence). Empty URL or secret disables it; feeds, search, mart and ads
# then use deterministic fallbacks. The shared secret signs every request (HMAC-SHA256, >= 32 chars).
INTELLIGENCE_BASE_URL=
INTELLIGENCE_SHARED_SECRET=
# Secret used to hash user ids before they leave the API (>= 32 chars; empty = derived from DATA_ENCRYPTION_KEY)
INTELLIGENCE_ID_HASH_SECRET=
# Client timeouts in milliseconds per endpoint family
INTELLIGENCE_RANKING_TIMEOUT_MS=100
INTELLIGENCE_SOCIAL_PROOF_TIMEOUT_MS=80
INTELLIGENCE_ADS_TIMEOUT_MS=120
INTELLIGENCE_RECOMMENDATIONS_TIMEOUT_MS=150
INTELLIGENCE_EVENTS_TIMEOUT_MS=2000
# Circuit breaker: opens after N consecutive failures or when the error rate in the window exceeds the percent
INTELLIGENCE_BREAKER_FAILURE_THRESHOLD=5
INTELLIGENCE_BREAKER_ERROR_RATE_PERCENT=50
INTELLIGENCE_BREAKER_WINDOW_MS=10000
INTELLIGENCE_BREAKER_MINIMUM_REQUESTS=10
INTELLIGENCE_BREAKER_HALF_OPEN_AFTER_MS=5000
# Event forwarding: events per batch (<= 500), flush interval, retry attempts and first retry delay
INTELLIGENCE_EVENT_BATCH_SIZE=200
INTELLIGENCE_EVENT_FLUSH_INTERVAL_SECONDS=5
INTELLIGENCE_EVENT_MAX_ATTEMPTS=6
INTELLIGENCE_EVENT_RETRY_BACKOFF_MS=1000

# Ads: creator share of ad revenue served on their content (4000 = 40%), click-to-order attribution window,
# click fraud limit per viewer, and how long a served ad can still record impressions/clicks
AD_CREATOR_REVENUE_SHARE_BPS=4000
AD_CLICK_ATTRIBUTION_WINDOW_DAYS=7
AD_MAX_CLICKS_PER_VIEWER_PER_HOUR=20
AD_SERVED_LIFETIME_HOURS=24

# Support: where support-ticket, contact, legal and copyright notification emails go (comma-separated).
# Use the company mailboxes from docs/emailAddresses.md; EMAIL_FROM stays the no-reply sender.
SUPPORT_NOTIFICATION_EMAILS=support@zudomart.com
# Realtime chat sockets: one-time ticket lifetime, sockets per user, slow-consumer buffer limit, heartbeat
REALTIME_TICKET_TTL_SECONDS=30
REALTIME_MAX_CONNECTIONS_PER_USER=5
REALTIME_MAX_BUFFERED_BYTES=1048576
REALTIME_HEARTBEAT_SECONDS=30
CHAT_MAX_GROUP_MEMBERS=256
# Automation rules: default execution cap per rule per hour
AUTOMATION_DEFAULT_EXECUTIONS_PER_HOUR=60
