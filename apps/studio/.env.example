NEXT_PUBLIC_SITE_URL=http://localhost:3600
STUDIO_ORIGIN=http://localhost:3600
STUDIO_API_URL=http://localhost:8080
STUDIO_MEDIA_URL=
STUDIO_USE_MOCKS=true
STUDIO_REAL_API_PREFIXES=
STUDIO_SESSION_SECRET=replace-with-64-random-hex-characters

RTMP_INGEST_URL=rtmp://studio.zudomart.com/live
HLS_PLAYBACK_URL=https://studio.zudomart.com/hls
# Comma-separated LiveKit WHIP ingest origins the browser may POST to when going live from Studio (added to connect-src at build time).
STUDIO_WHIP_CONNECT_ORIGINS=
# Public WebSocket URL of the realtime service (defaults to STUDIO_API_URL + /ws). Read at build time for connect-src and at runtime by /bff/realtime.
STUDIO_REALTIME_URL=

# Company email domain (docs/emailAddresses.md). Addresses default to <name>@NEXT_PUBLIC_MAIL_DOMAIN.
NEXT_PUBLIC_MAIL_DOMAIN=zudomart.com
# Store badges link here once the apps are live; empty shows the official badges marked "Coming soon".
NEXT_PUBLIC_APP_STORE_ID=
NEXT_PUBLIC_PLAY_PACKAGE=
