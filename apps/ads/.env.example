NEXT_PUBLIC_SITE_URL=http://localhost:3300
ADS_ORIGIN=http://localhost:3300
ADS_API_URL=http://localhost:8080
ADS_MEDIA_URL=
# Origin of the presigned creative upload URLs go-ads returns (S3 or MinIO); added to the CSP connect-src.
ADS_UPLOAD_URL=http://localhost:18333
ADS_USE_MOCKS=true
ADS_REAL_API_PREFIXES=
ADS_SESSION_SECRET=replace-with-64-random-hex-characters
ADS_CHECKOUT_HOSTS=checkout.paystack.com,checkout.flutterwave.com
NEXT_PUBLIC_ADS_CHECKOUT_HOSTS=checkout.paystack.com

# Company email domain (docs/emailAddresses.md). Addresses default to <name>@NEXT_PUBLIC_MAIL_DOMAIN.
NEXT_PUBLIC_MAIL_DOMAIN=zudomart.com
# Store badges link here once the apps are live; empty shows the official badges marked "Coming soon".
NEXT_PUBLIC_APP_STORE_ID=
NEXT_PUBLIC_PLAY_PACKAGE=
