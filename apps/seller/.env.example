NEXT_PUBLIC_SITE_URL=http://localhost:3200
DASHBOARD_ORIGIN=http://localhost:3200
SELLER_API_URL=http://localhost:8080
SELLER_MEDIA_URL=
# Object storage origins the browser PUTs presigned uploads to (product photos, business documents), comma separated.
SELLER_UPLOAD_ORIGINS=
NEXT_PUBLIC_ADS_MANAGER_URL=http://localhost:3300
NEXT_PUBLIC_MARKETING_SITE_URL=http://localhost:3100
SELLER_USE_MOCKS=true
# Domains backed by the real gateway (docs/integrations/frontendWiring.md). Still mocked: affiliates, brands, developers, integrations, ads summary, product import.
SELLER_REAL_API_PREFIXES=/api/v1/auth,/api/v1/users/me,/api/v1/account,/api/v1/media,/api/v1/seller/access,/api/v1/seller/subscription,/api/v1/seller/verification,/api/v1/seller/business-documents,/api/v1/seller/security,/api/v1/seller/conversations,/api/v1/seller/stores,/api/v1/seller/settings,/api/v1/seller/storefront,/api/v1/seller/locations,/api/v1/seller/staff,/api/v1/seller/audit-log,/api/v1/seller/nantty-users,/api/v1/seller/dashboard,/api/v1/seller/analytics,/api/v1/seller/products,/api/v1/seller/categories,/api/v1/seller/inventory,/api/v1/seller/suppliers,/api/v1/seller/orders,/api/v1/seller/returns,/api/v1/seller/disputes,/api/v1/seller/delivery,/api/v1/seller/shipping,/api/v1/seller/customers,/api/v1/seller/reviews,/api/v1/seller/promotions,/api/v1/seller/marketing,/api/v1/seller/reports,/api/v1/seller/wallet,/api/v1/seller/finance,/api/v1/payments/payout-onboarding,/api/v1/payments/payout-fees
SELLER_SESSION_SECRET=replace-with-64-random-hex-characters

# Company email domain (docs/emailAddresses.md). Addresses default to <name>@NEXT_PUBLIC_MAIL_DOMAIN.
NEXT_PUBLIC_MAIL_DOMAIN=nantty.com
# Store badges link here once the apps are live; empty shows the official badges marked "Coming soon".
NEXT_PUBLIC_APP_STORE_ID=
NEXT_PUBLIC_PLAY_PACKAGE=
