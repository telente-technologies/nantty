{
  "cli": {
    "version": ">= 24.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.22.1",
      "pnpm": "11.24.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCKS": "false"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_SELLER_WEB_URL": "https://creator.nantty.com",
        "EXPO_PUBLIC_ADS_MANAGER_URL": "https://ads.nantty.com"
      }
    },
    "demo": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCKS": "true",
        "EXPO_PUBLIC_SELLER_WEB_URL": "https://creator.nantty.com",
        "EXPO_PUBLIC_ADS_MANAGER_URL": "https://ads.nantty.com"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCKS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
