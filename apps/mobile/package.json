      "/node_modules/@react-native/babel-preset/"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@nantty/web-kit/brandPath$": "<rootDir>/../../packages/webKit/src/brand/nanttyBrand.path.ts"
    }
