{
  "expo": {
    "name": "Zudomart",
    "slug": "zudomart",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zudomart.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.zudomart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptiveIconForeground.png",
        "backgroundColor": "#2043F5"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:3000"
    },
    "scheme": ["zudomart", "com.zudomart.app"],
    "plugins": [
      "expo-video",
      "expo-background-task",
      "expo-sqlite",
      "expo-audio",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FE"
        }
      ]
    ]
  }
}
