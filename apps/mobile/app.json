{
  "expo": {
    "name": "Nantty",
    "slug": "nantty",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nantty.app",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.nantty.app"
        ]
      }
    },
    "android": {
      "package": "com.nantty.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptiveIconForeground.png",
        "backgroundImage": "./assets/adaptiveIconBackground.png",
        "monochromeImage": "./assets/adaptiveIconMonochrome.png",
        "backgroundColor": "#2043F5"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:8080",
      "eas": {
        "projectId": "47fadf5d-9059-49f9-8673-56453ca26a58"
      }
    },
    "scheme": [
      "nantty",
      "nantty",
      "com.nantty.app"
    ],
    "plugins": [
      "expo-video",
      "expo-background-task",
      "expo-sqlite",
      "expo-audio",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Nantty to unlock your chats with Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashLogo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FE",
          "dark": {
            "image": "./assets/splashLogo.png",
            "backgroundColor": "#0E0E10"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Nantty to use your location when you choose to share it in a chat."
        }
      ],
      "expo-document-picker",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow Nantty to save photos and videos you download.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-dev-client",
      "expo-iap",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true,
          "color": "#2043F5"
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NanttyOrders",
              "label": "Orders",
              "description": "Track your active orders and delivery times.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NanttySellerToday",
              "label": "Sales today",
              "description": "Today's sales, orders to ship and your balance.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NanttyLiveNow",
              "label": "Live now",
              "description": "Creators you follow who are live right now.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NanttyCreatorToday",
              "label": "Creator stats",
              "description": "Today's views, new followers and earnings.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NanttyStories",
              "label": "Stories",
              "description": "New stories from people you follow.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Nantty to use your camera when you go live.",
          "microphonePermission": "Allow Nantty to use your microphone when you go live."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "owner": "oyinlola141"
  }
}
