{
  "expo": {
    "name": "Zudomart",
    "slug": "zudomart",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zudomart.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.zudomart.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptiveIconForeground.png",
        "backgroundColor": "#2043F5"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:8080",
      "eas": {
        "projectId": "47fadf5d-9059-49f9-8673-56453ca26a58"
      }
    },
    "scheme": [
      "zudomart",
      "com.zudomart.app"
    ],
    "plugins": [
      "expo-video",
      "expo-background-task",
      "expo-sqlite",
      "expo-audio",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Zudomart to unlock your chats with Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FE"
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Zudomart to use your location when you choose to share it in a chat."
        }
      ],
      "expo-document-picker"
    ],
    "owner": "oyinlola141"
  }
}
