# Everything here is bundled into the app and readable by anyone who
# downloads it. Public values only: never put API secrets or payment
# secret keys in the mobile app.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_USE_MOCKS=true
# Comma-separated path prefixes sent to the real gateway while mocks stay on, e.g. /api/v1/auth,/api/v1/users
EXPO_PUBLIC_REAL_API_PREFIXES=

# Cloudflare Turnstile site key (public). Reserved for a native WebView renderer: today the app opens
# <webapp>/security-check in the in-app browser, which reads NEXT_PUBLIC_TURNSTILE_SITE_KEY.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Company email domain (docs/emailAddresses.md)
EXPO_PUBLIC_MAIL_DOMAIN=zudomart.com
