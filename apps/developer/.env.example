# Public site origin for metadata and canonical URLs. Set to the assigned HTTPS origin in deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3700
NEXT_PUBLIC_DOCS_SITE_URL=http://localhost:3700
NEXT_PUBLIC_SANDBOX_PORTAL_URL=http://localhost:3800
NEXT_PUBLIC_NANTTY_WEB_URL=http://localhost:3500
# Server-only Nantty gateway origin used for readiness and authenticated organization API requests.
# This must remain server-side; do not rename this to a NEXT_PUBLIC variable.
DEVELOPER_API_BASE_URL=http://localhost:8080
# Server-only Sandbox control connection. Keep these out of NEXT_PUBLIC_* variables.
SANDBOX_API_BASE_URL=http://localhost:8090
SANDBOX_CONTROL_TOKEN=replace-with-the-same-random-32-plus-character-token-as-sandbox
