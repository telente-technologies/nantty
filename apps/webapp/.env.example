NEXT_PUBLIC_SITE_URL=http://localhost:3500
NEXT_PUBLIC_MARKETING_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SELLER_WEB_URL=http://localhost:3200
NEXT_PUBLIC_ADS_MANAGER_URL=http://localhost:3300
WEBAPP_ORIGIN=http://localhost:3500
WEBAPP_API_URL=http://localhost:8080
WEBAPP_MEDIA_URL=
WEBAPP_UPLOAD_ORIGINS=
# The LiveKit URL go-live hands out (LIVEKIT_PUBLIC_URL), so the CSP lets the live player connect to it.
WEBAPP_LIVEKIT_URL=ws://localhost:7880
S3_PUBLIC_ENDPOINT=http://localhost:18333
S3_REGION=eu-west-1
MEDIA_QUARANTINE_BUCKET=nantty-media-quarantine
WEBAPP_USE_MOCKS=true
# Add /ws here (or turn mocks off) to enable live updates against the real realtime service.
WEBAPP_REAL_API_PREFIXES=
# Public WebSocket URL of the realtime service (defaults to WEBAPP_API_URL + /ws); also added to connect-src.
WEBAPP_REALTIME_URL=
WEBAPP_SESSION_SECRET=replace-with-64-random-hex-characters

# Public OAuth client IDs. Register NEXT_PUBLIC_SITE_URL as an authorized web origin with Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Apple Services ID; register the production domain and use NEXT_PUBLIC_SITE_URL as its return URL.
NEXT_PUBLIC_APPLE_CLIENT_ID=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Company email domain (docs/emailAddresses.md). Addresses default to <name>@NEXT_PUBLIC_MAIL_DOMAIN.
NEXT_PUBLIC_MAIL_DOMAIN=nantty.com
# Store badges link here once the apps are live; empty shows the official badges marked "Coming soon".
NEXT_PUBLIC_APP_STORE_ID=
NEXT_PUBLIC_PLAY_PACKAGE=
