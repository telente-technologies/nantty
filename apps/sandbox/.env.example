# Public site origin for metadata and canonical URLs. Set to the assigned HTTPS origin in deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3800
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=http://localhost:3700
NEXT_PUBLIC_NANTTY_WEB_URL=http://localhost:3500
# Server-only origin of the isolated Sandbox API gateway. Production accepts only
# sandbox-api.nantty.com or *.sandbox.nantty.com HTTPS origins; it never forwards to production.
SANDBOX_API_BASE_URL=http://localhost:3901
# Server-only origin of the Identity / Developer API gateway used to verify application capabilities.
DEVELOPER_API_BASE_URL=http://localhost:3500
# Service-only control bearer token shared with services/typescript/sandbox (>= 32 chars).
SANDBOX_CONTROL_TOKEN=
