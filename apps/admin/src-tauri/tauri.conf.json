{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nantty Admin",
  "version": "0.1.0",
  "identifier": "com.nantty.admin",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3400",
    "frontendDist": "../desktop-placeholder"
  },
  "app": {
    "windows": [
      {
        "title": "Nantty Admin",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
