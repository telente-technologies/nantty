ADMIN_API_URL=http://localhost:8080
ADMIN_ORIGIN=http://localhost:3400
ADMIN_USE_MOCKS=true
ADMIN_REAL_API_PREFIXES=
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_ENVIRONMENT=development
# Comma-separated IPs or IPv4 CIDRs (e.g. 203.0.113.7,10.20.0.0/16). Empty = allow all, but only
# when ADMIN_ENVIRONMENT is not production. Production refuses to start without it (src/instrumentation.ts).
# The console reads the first X-Forwarded-For hop, so put it behind a proxy that overwrites that header.
ADMIN_IP_ALLOWLIST=
ADMIN_MEDIA_URL=

# Company email domain (docs/emailAddresses.md). Addresses default to <name>@NEXT_PUBLIC_MAIL_DOMAIN.
NEXT_PUBLIC_MAIL_DOMAIN=nantty.com
