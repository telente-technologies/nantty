{
  "platform": {
    "database": "One primary Aurora PostgreSQL cluster with PostGIS (one database). Each service owns one schema and is the only writer of its tables; every other service gets read-only access through the shared zudomart_readers role, granted per table/column in the owner's migrations. One login role per service (svc_<service>).",
    "ownership": {
      "go": "accounts/users, wallet/ledger, payments, marketplace (catalog, inventory), orders",
      "typescript": "social orchestration (posts, feed, notifications, media metadata)",
      "elixir": "realtime (sockets, presence, chat delivery)",
      "python": "AI/ML and analytics",
      "opensearch": "search indexes (later, fed from events)",
      "redis": "cache and ephemeral realtime state"
    },
    "events": "No Kafka on day one. Business write + outbox row commit in one Postgres transaction; a relay publishes to the DomainEventPublisher interface (AWS: SNS topic zudomart-domain-events, fan-out to per-consumer SQS queues with eventType filter policies; EventBridge when cross-account/rule routing is needed). Kafka/MSK can replace the publisher later without touching business code.",
    "jobs": "Background jobs (email, media processing, thumbnails, reports, payouts, search indexing) go through the JobQueue interface (AWS: SQS with dead-letter queues). Consumers are idempotent on the job/event id.",
    "domainEventExamples": [
      "order.created",
      "payment.completed",
      "gift.sent",
      "stream.started",
      "post.created",
      "user.followed",
      "content.reported",
      "account.registered"
    ],
    "compute": "ECS on Fargate first (not EKS). Step Functions only for real multi-step orchestration (payout runs, dispute timelines). Go services ship as 6 deployables: go-identity (auth, users, currency, admin), go-commerce (catalog, inventory, orders, analytics), go-money (payments, wallet, ledger, escrow, subscriptions, creators, rewards), go-live (live), go-ads (ads), go-trust (moderation).",
    "media": "Media bytes live in S3 behind CloudFront; Postgres stores only metadata and keys. LiveKit carries live video.",
    "later": "OpenSearch (search) and ClickHouse (seller/creator analytics) come later, fed from domain events.",
    "decisions": "Python returns scores (ranking, fraud risk, moderation classification) and never makes the final financial or moderation call; Go/TS apply a deterministic policy (allow / hold / review / reject) and record it. Feed and clip ranking runs a safety/integrity filter before ranking.",
    "local": "infra/local/docker-compose.yml: Postgres 17 + PostGIS, Valkey, LocalStack 4.9 (SNS/SQS), SeaweedFS (S3), LiveKit, OTel collector + Jaeger; OpenSearch and ClickHouse behind compose profiles."
  },
