      "categories": { "commands": ["createLiveCategory", "updateLiveCategory", "archiveLiveCategory"], "queries": ["listLiveCategories"], "events": ["liveCategoryChanged"], "stack": "Go live service + Postgres", "why": "Categories (shopping, music, gaming, talk, education) drive discovery and let creators stream without selling; listing is cache-friendly and owned next to the session it labels." },
      "gifts": { "commands": ["sendGiftWithIdempotencyKey", "extendGiftCombo", "createGift", "updateGift", "retireGift"], "queries": ["listGiftCatalog", "listTopGiftersForSession", "listTopGiftersForCreator"], "events": ["giftSent", "giftComboExtended", "topGiftersChanged"], "stack": "Go live + wallet/ledger (coins debited via postBalancedJournalEntry), fan-out via Elixir realtime", "why": "Gifting is money movement at chat speed: Go gives a cheap synchronous path to the ledger with an Idempotency-Key per tap, combos are a short Redis window keyed by sender+gift+session, top gifters are a Redis sorted set rebuilt from ledger events; Phoenix PubSub fans the animation out to every viewer without touching Go." },
