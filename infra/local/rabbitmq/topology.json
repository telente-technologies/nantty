    "intelligence-domain-events": [
      "account.registered", "account.loggedIn", "account.deletionRequested", "account.deletionExecuted",
      "ad.impressionRecorded", "block.created", "consent.granted", "consent.withdrawn", "follow.created",
      "gift.sent", "media.processed", "message.sent", "post.created", "product.viewed", "product.purchased", "report.created",
      "post.liked", "post.shared", "comment.created", "comment.hidden", "comment.unhidden", "content.saved", "post.viewed", "clip.watched"
    ]
  },
  "jobQueues": [
    "jobs-email", "jobs-media", "jobs-reports", "jobs-payouts", "jobs-subscription-billing", "jobs-catalog-import", "jobs-search-indexing", "jobs-ads-reports",
    "intelligence-trust-advisory", "intelligence-trust-content-scores", "intelligence-trust-live-safety", "intelligence-trust-bot-scores", "jobs-live-frames", "jobs-live-audio"
  ]
}
