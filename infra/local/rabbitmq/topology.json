    "identity-domain-events": ["entitlement.granted", "entitlement.revoked", "entitlement.graceStarted", "account.registered", "verificationRefund.*", "sellerApplication.reviewed"],
    "catalog-domain-events": ["content.visibilityChanged"],
    "live-domain-events": ["content.visibilityChanged", "accountHealth.changed", "live.safetyHold", "live.safetyReleased", "live.safetyWarning", "live.samplingBoosted", "live.moderatorEnded"],
    "social-domain-events": ["content.visibilityChanged", "content.sensitivityAdvised", "media.processed", "media.rejected", "copyrightClaim.audioMuteOrdered", "copyrightClaim.restored", "chatReport.received", "store.staff_removed", "store.staff_updated"],
    "realtime-domain-events": [
      "battle.*", "gift.sent", "goal.*", "guest.*", "leaderboard.updated", "live.*", "stage.updated",
      "liveComment.*", "liveRoomSettings.updated", "liveViewer.*", "liveRecording.*", "overlayScene.*", "liveSafety.*",
      "message.created", "message.updated", "message.removed", "message.reactionsChanged",
      "conversation.read", "conversation.updated", "conversation.memberRemoved", "conversation.memberLeft",
      "notification.created", "account.suspended", "account.banned", "session.revoked", "session.refreshTokenReuseDetected"
