{
  "vhost": "zudomart",
  "administrator": "zudomart",
  "retryTiers": { "30s": 30000, "2m": 120000, "10m": 600000, "30m": 1800000 },
  "unroutedRetentionMs": 86400000,
  "services": {
    "go-identity": { "publishesEvents": true, "consumes": ["identity-domain-events"] },
    "go-commerce": { "publishesEvents": true, "enqueuesJobs": true, "consumes": ["commerce-domain-events", "catalog-domain-events", "jobs-catalog-import"] },
    "go-live": { "publishesEvents": true, "enqueuesJobs": true, "consumes": ["live-domain-events"] },
    "go-money": { "publishesEvents": true, "enqueuesJobs": true, "consumes": ["jobs-payouts", "jobs-subscription-billing", "money-domain-events"] },
    "go-ads": { "publishesEvents": true, "enqueuesJobs": true, "consumes": ["jobs-ads-reports", "ads-domain-events"] },
    "go-trust": { "publishesEvents": true, "consumes": ["intelligence-trust-advisory", "intelligence-trust-content-scores", "intelligence-trust-live-safety", "intelligence-trust-bot-scores", "trust-domain-events"] },
    "search": { "consumes": ["search-domain-events"] },
    "support": { "publishesEvents": true, "consumes": ["support-domain-events"] },
    "social": { "publishesEvents": true, "consumes": ["social-domain-events"] },
    "media": { "publishesEvents": true, "enqueuesJobs": true, "consumes": ["media-domain-events", "jobs-media"] },
    "notifications": { "publishesEvents": true, "enqueuesJobs": true, "consumes": ["notifications-domain-events", "jobs-email"] },
    "realtime": { "consumes": ["realtime-domain-events"] },
    "intelligence": { "publishesEvents": true, "enqueuesJobs": true, "consumes": ["intelligence-domain-events", "jobs-live-frames", "jobs-live-audio"] }
  },
  "eventQueues": {
