    "support-domain-events": ["account.deletionExecuted"],
    "money-domain-events": ["orderGroup.refundRequested", "businessVerification.approved", "businessVerification.revoked", "creatorApplication.approved", "adSpend.batched", "verificationCase.refundRequested", "accountHealth.changed", "creatorSubscription.paid", "creatorSubscription.refunded", "adCreatorEarnings.posted", "orderGroup.completed", "escrow.refunded", "escrow.partiallyRefunded", "verificationCase.decided", "checkmark.revoked", "paymentRefund.requested", "paymentRefund.failed", "orderGroup.delivered", "orderGroup.shipped", "orderGroup.paid", "orderGroup.statusChanged"],
    "ads-domain-events": ["accountHealth.changed", "adBalance.toppedUp", "adBalance.topUpFailed", "post.deleted", "adBoost.cancelled", "creatorApplication.decided", "creator.standingChanged"],
    "commerce-domain-events": ["escrow.held", "escrow.released", "escrow.refunded", "escrow.partiallyRefunded", "escrow.releaseScheduled", "escrow.refundScheduled", "directPayment.received", "dispute.opened", "dispute.closed"],
    "notifications-domain-events": ["account.*", "adInvite.created", "appeal.*", "cardVerification.*", "checkmark.*", "coinPurchase.*", "comment.created", "comment.hidden", "comment.unhidden", "post.deleted", "creatorApplication.*", "creatorSubscription.started", "affiliateCommission.credited", "dataExport.*", "dispute.*", "disputeMessage.*", "escrow.*", "follow.created", "followRequest.created", "gift.sent", "live.started", "live.reminderDue", "mention.created", "messageRequest.received", "post.created", "order.*", "otp.issued", "post.tagged", "payment.*", "paymentRefund.bankDetailsRequired", "payout.*", "payoutAccount.*", "planInvoice.*", "planTrial.*", "subscriptionInvoice.*", "subscriptionOffer.sent", "subscriptionPayment.*", "subscriptionTrial.*", "subscriptionRenewal.*", "subscriptionGrace.*", "subscriptionCard.*", "subscriptionPrice.*", "subscription.downgraded", "tip.sent", "policyVersion.published", "report.closed", "review.created", "review.replied", "sellerApplication.reviewed", "creator.standingChanged", "message.sent", "sellerDocuments.*", "session.*", "signIn.*", "ticket.created", "ticket.replied", "ticket.resolved", "twoFactor.*", "videoReply.created", "withdrawal.*", "copyrightClaim.warningIssued", "copyrightClaim.audioMuteOrdered", "copyrightClaim.contentTakenDown", "copyrightClaim.counterNoticeReceived", "copyrightClaim.restored", "strike.issued", "strike.expired", "verification.eligible", "verification.underReview", "verification.approved", "verification.rejectedRefunded"],
