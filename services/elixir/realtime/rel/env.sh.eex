#!/bin/sh
# DNSCluster needs long node names on the task IP so ECS tasks can find each other.
if [ -n "$DNS_CLUSTER_QUERY" ]; then
  if [ -z "$RELEASE_NODE" ]; then
    task_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    if [ -z "$task_ip" ]; then
      echo "Unable to determine task IP for DNS-clustered realtime release" >&2
      exit 1
    fi

    export RELEASE_NODE="<%= @release.name %>@${task_ip}"
  fi

  export RELEASE_DISTRIBUTION=name
fi
