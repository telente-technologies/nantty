# Checkmark identity verification (Smile ID). Partner ID and API key come from the Smile ID portal
# (Account settings > API keys); use the sandbox key with SMILE_ID_ENVIRONMENT=sandbox until go-live.
# The callback URL must be the public gateway address; Smile ID signs every callback with the same API key.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENVIRONMENT=sandbox
SMILE_ID_CALLBACK_URL=http://localhost:8080/api/v1/webhooks/smile-id
VERIFICATION_BIOMETRIC_CONSENT_VERSION=2026-10-04
VERIFICATION_PRIVACY_POLICY_URL=https://zudomart.com/legal/privacy
# Keyed hash for "same ID used on another account" detection; the ID number itself is never stored.
VERIFICATION_DOCUMENT_FINGERPRINT_KEY=
VERIFICATION_ELIGIBILITY_RECHECK_EVERY=24h
VERIFICATION_ELIGIBILITY_WORKER_INTERVAL=1h
WEB_APP_BASE_URL=http://localhost:3500
INTELLIGENCE_URL=http://localhost:8090
INTELLIGENCE_SHARED_SECRET=
