# Flutterwave is the only payment provider. Production refuses to start without FLUTTERWAVE_SECRET_KEY,
# FLUTTERWAVE_WEBHOOK_HASH and FLUTTERWAVE_MERCHANT_ID; local development may leave them empty.
PAYMENTS_PROVIDER=flutterwave
CHECKOUT_CHANNELS=card,bank,ussd,bank_transfer
PAYMENT_SPLIT_BEARER=subaccount
CARD_VERIFICATION_AMOUNT_MINOR=5000
PAYMENT_PLAN_CODES=
# Flutterwave v3 (payout subaccounts). FLWSECK_TEST- outside production, FLWSECK- in production.
FLUTTERWAVE_API_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=
# The dashboard "secret hash"; Flutterwave sends it back in verif-hash. At least 32 random characters.
FLUTTERWAVE_WEBHOOK_HASH=
# Our F4B merchant id: the account_number for PSA -> main transfers.
FLUTTERWAVE_MERCHANT_ID=
FLUTTERWAVE_SUPPORTED_CURRENCIES=NGN,GHS,KES,ZAR,USD
FLUTTERWAVE_TRANSFER_CALLBACK_URL=
FLUTTERWAVE_MAXIMUM_READ_ATTEMPTS=3
WALLET_ALIAS_EMAIL_DOMAIN=wallets.zudomart.com
WALLET_PSA_COUNTRIES=NG
# Zudomart's deposit fee (swept from each deposit) and its cap per currency in minor units; owner to confirm.
WALLET_DEPOSIT_FEE_BPS=50
WALLET_DEPOSIT_FEE_CAPS=NGN:100000
# Fallbacks only: the admin settings seller.debtLimits and payments.limits are the source of truth. Naira amounts in kobo;
# other currencies are converted with the currency module's rates (seller debt at the percentage below) unless overridden in admin.
SELLER_DEBT_LIMITS_NGN=unverified:1000000,payoutVerified:5000000,identityVerified:20000000
SELLER_DEBT_LIMIT_OUTSIDE_NIGERIA_PERCENT=50
SELLER_TRUSTED_AGE_DAYS=90
SELLER_TRUSTED_CLEAN_DAYS=90
PAYMENT_MINIMUM_AMOUNTS=NGN:100,GHS:100,KES:100,USD:100
PAYMENT_MAXIMUMS_NGN=orderCheckout:500000000,coinPurchase:50000000,adsTopUp:1000000000
WALLET_DAILY_LIMITS_NGN=basic:5000000,mid:20000000,full:500000000
DEPOSIT_WITHDRAWAL_COOLDOWN=24h
FIRST_DEPOSIT_WITHDRAWAL_COOLDOWN=72h
WALLET_CARD_BUYER_PSA_AT_CHECKOUT=true
WALLET_RECONCILIATION_DRIFT_TOLERANCE_MINOR=0
WALLET_MOVEMENT_STUCK_AFTER=1h
WALLET_MOVEMENT_WORKER_INTERVAL=30s
PAYMENTS_SETTLEMENT_POLL_INTERVAL=1h
ESCROW_MODE=e2
ESCROW_FEE_BPS=150
ESCROW_FEE_BUSINESS_PLAN_BPS=100
SAVED_CARD_FINGERPRINT_KEY=
MONEY_INTERNAL_API_TOKEN=
ADS_PREPAID_REFUNDS_ENABLED=false
WALLET_SELLER_RESERVE_HOLD_DAYS=90
SUBSCRIPTIONS_STORE_PRODUCT_PLANS=
PAYMENT_RETURN_URLS=https://zudomart.com/pay/return,http://localhost:3000/pay/return,http://localhost:3500/pay/return,http://localhost:3500/settings/verification
PAYMENT_ADS_RETURN_ORIGINS=https://ads.zudomart.com,http://localhost:3300
CONNECT_ONBOARDING_RETURN_URL=http://localhost:3000/seller/verification/return
CONNECT_ONBOARDING_REFRESH_URL=http://localhost:3000/seller/verification/refresh
CONNECT_ACCOUNT_COUNTRY=NG
CHECKOUT_SESSION_EXPIRY_MINUTES=15
PAYMENTS_ACCOUNT_DIRECTORY_SCHEMA=auth
PAYMENTS_ORDER_STATUS_SCHEMA=orders
WALLET_SELLER_SETTLEMENT_ADAPTER=providerTransfer
CREATOR_TRANSFER_MINIMUMS=NGN:10000,USD:100
COIN_NET_VALUES=NGN:1000,USD:1
COIN_CHANNEL_FEE_BPS=web:300,ios:3000,android:1500
# In-app purchases (coins and creator subscriptions). Leave the Apple bundle id or the Google package empty to keep that
# store off: the apps then get 503 STORE_BILLING_UNAVAILABLE before the fan pays. Setup: docs/integrations/appStoreProducts.md.
# Apple App Store Server API key (App Store Connect > Users and Access > Integrations > In-App Purchase).
APPLE_IAP_BUNDLE_ID=com.zudomart.app
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_IAP_API_BASE_URL=https://api.storekit-sandbox.itunes.apple.com
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# The .p8 key: a file path, or the PEM inline with \n line breaks in APPLE_IAP_PRIVATE_KEY_PEM.
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_PRIVATE_KEY_PEM=
# Apple Root CA - G3 (https://www.apple.com/certificateauthority/), used to verify signed transactions and notifications.
APPLE_IAP_ROOT_CERTIFICATES_PATH=
APPLE_IAP_ROOT_CERTIFICATES_PEM=
# Google Play Developer API service account with "View financial data" and "Manage orders and subscriptions".
GOOGLE_PLAY_PACKAGE_NAME=com.zudomart.app
GOOGLE_PLAY_API_BASE_URL=https://androidpublisher.googleapis.com
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Real-time Developer Notifications arrive as a Pub/Sub push with authentication enabled: Pub/Sub sends a
# Google-signed OIDC token, checked against this audience (the push endpoint URL) and the push service account.
GOOGLE_PLAY_RTDN_PUSH_AUDIENCE=
GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT=
# Optional shared secret for a relay that sets the X-Zudomart-Push-Token header instead.
GOOGLE_PLAY_RTDN_PUSH_TOKEN=
# Subscription products priced by Play itself (creator tiers); one-time products still need GOOGLE_PLAY_PRODUCT_PRICES.
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_PREFIXES=zudomart.creatorsub.
GOOGLE_PLAY_SUBSCRIPTION_PRODUCTS=
GOOGLE_PLAY_PRODUCT_PRICES=
# Coin and checkmark store fees. Creator subscription fees come from the admin setting appStore.fees.
APPLE_IAP_STORE_FEE_BPS=3000
GOOGLE_PLAY_STORE_FEE_BPS=1500
# Regional pricing: staff price edits in go-money are audited through the admin service (required in production).
ADMIN_INTERNAL_URL=http://localhost:8101
PRICING_TRUSTED_COUNTRY_HEADER=CloudFront-Viewer-Country
CURRENCY_DATABASE_SCHEMA=currency
DATA_ENCRYPTION_KEY=
WALLET_ACCOUNT_DIRECTORY_SCHEMA=auth
WALLET_WITHDRAWALS_REQUIRE_REVIEW=true
ESCROW_FEE_BPS=150
