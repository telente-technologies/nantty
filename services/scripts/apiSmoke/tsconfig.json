{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "load/**/*.ts", "vitest.config.ts"]
}
