{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/entitlement.revoked.v1.json",
  "title": "entitlement.revoked",
  "description": "A subscription stopped granting its plan (downgrade, expiry, store refund). Data is never locked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subscriptionId",
    "profileId",
    "profileType",
    "ownerUserId",
    "plan",
    "status"
  ],
  "properties": {
    "subscriptionId": {
      "type": "string"
    },
    "profileId": {
      "type": "string"
    },
    "profileType": {
      "type": "string"
    },
    "ownerUserId": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "checkmark": {
      "type": "string"
    },
    "sellerPlan": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "validUntil": {
      "type": "string"
    }
  }
}
