{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/planTrial.converted.v1.json",
  "title": "planTrial.converted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "storeName",
    "plan",
    "price",
    "interval",
    "nextBillingAt",
    "invoiceNumber"
  ],
  "properties": {
    "accountId": {
      "type": "string"
    },
    "storeName": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "interval": {
      "type": "string"
    },
    "nextBillingAt": {
      "type": "string"
    },
    "invoiceNumber": {
      "type": "string"
    }
  }
}
