{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/live.moderatorEnded.v1.json",
  "title": "live.moderatorEnded (go-trust; a moderator ended the live, go-live ends it and emits live.ended)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "liveId",
    "hostId",
    "incidentId",
    "reason",
    "suspended",
    "endedAt"
  ],
  "properties": {
    "liveId": {
      "type": "string"
    },
    "hostId": {
      "type": "string"
    },
    "incidentId": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "suspended": {
      "type": "boolean"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
