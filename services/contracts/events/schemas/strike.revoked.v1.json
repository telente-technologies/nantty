{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/strike.revoked.v1.json",
  "title": "StrikeRevoked",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strikeId",
    "accountId",
    "reason",
    "activeStrikeCount"
  ],
  "properties": {
    "strikeId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string"
    },
    "activeStrikeCount": {
      "type": "integer"
    }
  }
}
