{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/orderGroup.shipped.v1.json",
  "title": "OrderGroupShipped",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderGroupId",
    "occurredAt"
  ],
  "properties": {
    "orderGroupId": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "orderNumber": {
      "type": "string"
    },
    "storeId": {
      "type": "string"
    },
    "buyerAccountId": {
      "type": "string"
    },
    "sellerAccountId": {
      "type": "string"
    },
    "courierName": {
      "type": "string"
    },
    "trackingNumber": {
      "type": "string"
    },
    "trackingUrl": {
      "type": "string"
    },
    "sellerName": {
      "type": "string"
    },
    "buyerName": {
      "type": "string"
    },
    "paymentMode": {
      "type": "string"
    },
    "subtotalMinor": {
      "type": "integer"
    },
    "discountMinor": {
      "type": "integer"
    },
    "storeCreditMinor": {
      "type": "integer"
    },
    "shippingMinor": {
      "type": "integer"
    },
    "totalMinor": {
      "type": "integer"
    },
    "refundedMinor": {
      "type": "integer"
    },
    "currency": {
      "type": "string"
    },
    "shippingMethod": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "./orderGroup.item.v1.json"
      }
    },
    "shippedAt": {
      "type": "string",
      "format": "date-time"
    },
    "estimatedDeliveryAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
