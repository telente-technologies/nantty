{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/liveFrame.captured.v1.json",
  "title": "LiveFrameCaptured (job on jobs-live-frames; go-live sends, intelligence consumes)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "liveFrame.captured"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameId",
        "liveId",
        "hostId",
        "bucket",
        "frameRef",
        "capturedAt",
        "boosted",
        "holdActive"
      ],
      "properties": {
        "frameId": {
          "type": "string"
        },
        "liveId": {
          "type": "string"
        },
        "hostId": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "frameRef": {
          "type": "string",
          "description": "S3 key of the sampled JPEG frame"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "boosted": {
          "type": "boolean"
        },
        "holdActive": {
          "type": "boolean"
        }
      }
    }
  }
}
