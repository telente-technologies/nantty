{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/envelope.v1.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "source", "subject", "schemaVersion", "occurredAt", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*\\.[A-Za-z][A-Za-z0-9]*$" },
    "source": { "type": "string" },
    "subject": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  }
}
