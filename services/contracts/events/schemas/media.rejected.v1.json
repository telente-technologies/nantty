{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/media.rejected.v1.json",
  "title": "MediaRejected",
  "description": "The upload failed validation, the malware scan or moderation and was deleted. reason is a stable code such as TYPE_MISMATCH, MALWARE_DETECTED, MODERATION_REJECTED, DURATION_EXCEEDED or PROCESSING_FAILED.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mediaId", "ownerId", "purpose", "kind", "reason"],
  "properties": {
    "mediaId": { "type": "string", "format": "uuid" },
    "ownerId": { "type": "string", "format": "uuid" },
    "purpose": { "enum": ["post", "clip", "story", "avatar", "banner", "product", "chat", "voice", "document", "kyc", "adCreative", "dispute_evidence", "identity_document", "verification_document"] },
    "kind": { "enum": ["image", "video", "audio", "document"] },
    "reason": { "type": "string" }
  }
}
