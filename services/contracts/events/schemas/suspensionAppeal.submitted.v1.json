{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/suspensionAppeal.submitted.v1.json",
  "title": "SuspensionAppealSubmitted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "caseId",
    "message",
    "submittedAt"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "caseId": {
      "type": "string",
      "format": "uuid",
      "description": "The go-identity account suspension id; decide it with POST /api/v1/internal/suspensions/{caseId}/appeal/decide"
    },
    "message": {
      "type": "string"
    },
    "reasonCode": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "suspendedAt": {
      "type": "string",
      "format": "date-time"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deletionDueAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
