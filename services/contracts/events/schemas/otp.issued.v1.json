{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/otp.issued.v1.json",
  "title": "otp.issued",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "destination",
    "codeSealed",
    "keyId",
    "expiresAt",
    "purpose"
  ],
  "properties": {
    "destination": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "accountId": {
      "type": "string"
    },
    "expiresInMinutes": {
      "type": "integer"
    },
    "codeSealed": {
      "type": "string",
      "description": "base64(nonce||AES-256-GCM ciphertext||tag) of the code; key shared by goIdentity and notifications only"
    },
    "keyId": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
