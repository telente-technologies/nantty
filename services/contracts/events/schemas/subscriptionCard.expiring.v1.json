{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/subscriptionCard.expiring.v1.json",
  "title": "subscriptionCard.expiring",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "subscriptionId",
    "plan",
    "planLabel",
    "audience",
    "interval",
    "expiryMonth",
    "expiryYear",
    "chargeAt"
  ],
  "properties": {
    "accountId": {
      "type": "string"
    },
    "profileId": {
      "type": "string"
    },
    "subscriptionId": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "planLabel": {
      "type": "string"
    },
    "accountName": {
      "type": "string"
    },
    "storeName": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "enum": [
        "personal",
        "business"
      ]
    },
    "interval": {
      "type": "string",
      "enum": [
        "month",
        "year"
      ]
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "cardLabel": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "expiryMonth": {
      "type": "integer"
    },
    "expiryYear": {
      "type": "integer"
    },
    "chargeAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
