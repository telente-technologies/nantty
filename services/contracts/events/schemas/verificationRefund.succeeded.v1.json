{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/verificationRefund.succeeded.v1.json",
  "title": "verificationRefund.succeeded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "subscriptionId",
    "accountId",
    "channel",
    "amount",
    "path"
  ],
  "properties": {
    "caseId": {
      "type": "string"
    },
    "subscriptionId": {
      "type": "string"
    },
    "accountId": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "amount": {
      "type": "object",
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "path": {
      "type": "string"
    },
    "refundScope": {
      "type": "string",
      "enum": [
        "full",
        "checkmark_share"
      ]
    },
    "refundAmount": {
      "type": "object",
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        }
      }
    }
  }
}
