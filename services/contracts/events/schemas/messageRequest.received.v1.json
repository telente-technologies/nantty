{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/messageRequest.received.v1.json",
  "title": "MessageRequestReceived",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipientUserId",
    "actor",
    "conversationId"
  ],
  "properties": {
    "recipientUserId": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "url": {
      "type": "string"
    },
    "conversationId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
