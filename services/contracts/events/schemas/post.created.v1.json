{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/post.created.v1.json",
  "title": "PostCreated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "postId",
    "authorId",
    "kind",
    "audience",
    "visibility",
    "isAiGenerated"
  ],
  "properties": {
    "postId": {
      "type": "string",
      "format": "uuid"
    },
    "authorId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "post",
        "clip",
        "story"
      ]
    },
    "audience": {
      "enum": [
        "everyone",
        "followers"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "subscribers"
      ]
    },
    "isAiGenerated": {
      "type": "boolean"
    },
    "text": {
      "type": "string",
      "maxLength": 2000
    },
    "mediaIds": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,64}$"
      },
      "maxItems": 20
    },
    "productIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "replyPolicy": {
      "type": "string"
    },
    "sensitiveLabels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
