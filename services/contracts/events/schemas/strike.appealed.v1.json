{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/strike.appealed.v1.json",
  "title": "StrikeAppealed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strikeId",
    "accountId",
    "kind",
    "source"
  ],
  "properties": {
    "strikeId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "warning",
        "strike"
      ]
    },
    "source": {
      "type": "string"
    }
  }
}
