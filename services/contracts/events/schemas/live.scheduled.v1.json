{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/live.scheduled.v1.json",
  "title": "LiveScheduled",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "liveId",
    "hostId",
    "title",
    "category",
    "scheduledAt"
  ],
  "properties": {
    "liveId": {
      "type": "string",
      "format": "uuid"
    },
    "hostId": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "scheduledAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
