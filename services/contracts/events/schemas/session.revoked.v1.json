{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/session.revoked.v1.json",
  "title": "SessionRevoked",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "sessionId",
    "reason"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string"
    },
    "reason": {
      "enum": [
        "logout",
        "revoke_all"
      ]
    }
  }
}
