{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/clipAudio.muteRequested.v1.json",
  "title": "ClipAudioMuteRequested",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimId",
    "soundId",
    "targetType",
    "targetId",
    "mediaIds"
  ],
  "properties": {
    "claimId": {
      "type": "string",
      "format": "uuid"
    },
    "soundId": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetType": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "mediaIds": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
