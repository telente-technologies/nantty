{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/strike.expired.v1.json",
  "title": "StrikeExpired",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strikeId",
    "accountId",
    "kind",
    "policy",
    "source",
    "expiredAt",
    "activeStrikeCount"
  ],
  "properties": {
    "strikeId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "warning",
        "strike"
      ]
    },
    "policy": {
      "type": "string"
    },
    "source": {
      "enum": [
        "moderation",
        "copyright",
        "manual",
        "ip_claim"
      ]
    },
    "expiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "activeStrikeCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
