{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/adBalance.toppedUp.v1.json",
  "title": "AdBalanceToppedUp",
  "description": "Prepaid ad credit was added to an ad account, by Flutterwave top-up or from the owner's withdrawable earnings (source = earnings).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adAccountId",
    "topUpId",
    "fundedByUserId",
    "amount"
  ],
  "properties": {
    "adAccountId": {
      "type": "string"
    },
    "topUpId": {
      "type": "string",
      "format": "uuid"
    },
    "fundedByUserId": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "flutterwave",
        "earnings"
      ]
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    }
  }
}
