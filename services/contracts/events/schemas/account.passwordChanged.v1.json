{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/account.passwordChanged.v1.json",
  "title": "AccountPasswordChanged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "sessionsRevoked",
    "method"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionsRevoked": {
      "type": "integer",
      "minimum": 0
    },
    "method": {
      "enum": [
        "reset",
        "change"
      ]
    }
  }
}
