{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/sound.updated.v1.json",
  "title": "SoundUpdated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "soundId"
  ],
  "properties": {
    "soundId": {
      "type": "string"
    },
    "moderationVisibility": {
      "enum": [
        "visible",
        "restricted",
        "hidden",
        "removed"
      ]
    },
    "copyrightAudio": {
      "enum": [
        "disabled",
        "available"
      ]
    },
    "claimId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
