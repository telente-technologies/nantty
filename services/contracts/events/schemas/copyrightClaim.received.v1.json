{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/copyrightClaim.received.v1.json",
  "title": "CopyrightClaimReceived",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimId",
    "targetType",
    "targetId"
  ],
  "properties": {
    "claimId": {
      "type": "string",
      "format": "uuid"
    },
    "targetType": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "claimScope": {
      "enum": [
        "audio",
        "video"
      ]
    }
  }
}
