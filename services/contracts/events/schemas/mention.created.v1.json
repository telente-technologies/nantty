{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/mention.created.v1.json",
  "title": "MentionCreated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipientUserId",
    "actor",
    "surface"
  ],
  "properties": {
    "recipientUserId": {
      "type": "string",
      "format": "uuid"
    },
    "mentionedUserId": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "authorId": {
      "type": "string",
      "format": "uuid"
    },
    "surface": {
      "enum": [
        "post",
        "comment",
        "group"
      ]
    },
    "postId": {
      "type": "string",
      "format": "uuid"
    },
    "commentId": {
      "type": "string",
      "format": "uuid"
    },
    "conversationId": {
      "type": "string",
      "format": "uuid"
    },
    "excerpt": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "mentionedEveryone": {
      "type": "boolean"
    },
    "notificationsMuted": {
      "type": "boolean",
      "description": "Set by social when the recipient turned off notifications for this post. Notifications drops the event."
    }
  }
}
