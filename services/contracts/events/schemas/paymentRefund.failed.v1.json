{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/paymentRefund.failed.v1.json",
  "title": "PaymentRefundFailed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "refundId",
    "paymentIntentId",
    "reference",
    "amount"
  ],
  "properties": {
    "refundId": {
      "type": "string"
    },
    "paymentIntentId": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
