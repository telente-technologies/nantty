{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/store.statusChanged.v1.json",
  "title": "StoreStatusChanged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storeId",
    "ownerAccountId",
    "status",
    "previousStatus",
    "reason"
  ],
  "properties": {
    "storeId": {
      "type": "string"
    },
    "ownerAccountId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "suspended"
      ]
    },
    "previousStatus": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  }
}
