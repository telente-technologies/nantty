{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/reconciliationBreak.found.v1.json",
  "title": "ReconciliationBreakFound",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "provider",
    "kind",
    "providerReference",
    "currency",
    "expectedAmountMinor",
    "providerAmountMinor"
  ],
  "properties": {
    "runId": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "missingInLedger",
        "missingAtProvider",
        "amountMismatch",
        "currencyMismatch"
      ]
    },
    "providerReference": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "expectedAmountMinor": {
      "type": "integer"
    },
    "providerAmountMinor": {
      "type": "integer"
    }
  }
}
