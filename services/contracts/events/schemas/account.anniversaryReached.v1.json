{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/account.anniversaryReached.v1.json",
  "title": "AccountAnniversaryReached",
  "type": "object",
  "additionalProperties": false,
  "required": ["accountId", "years", "localDate", "timezone", "joinedAt"],
  "properties": {
    "accountId": { "type": "string", "format": "uuid" },
    "years": { "type": "integer", "minimum": 1 },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timezone": { "type": "string" },
    "joinedAt": { "type": "string", "format": "date-time" },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "posts": { "type": "integer", "minimum": 0 },
        "lives": { "type": "integer", "minimum": 0 },
        "followers": { "type": "integer", "minimum": 0 },
        "orders": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
