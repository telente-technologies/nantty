{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/account.banned.v1.json",
  "title": "AccountBanned",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "caseId",
    "reason",
    "policy",
    "policyUrl",
    "appealUrl",
    "until",
    "permanent"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "caseId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "policyUrl": {
      "type": "string"
    },
    "appealUrl": {
      "type": "string"
    },
    "until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "permanent": {
      "type": "boolean"
    }
  }
}
