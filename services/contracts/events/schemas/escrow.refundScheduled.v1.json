{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/escrow.refundScheduled.v1.json",
  "title": "EscrowRefundScheduled",
  "description": "A refund arrived before the buyer's card payment settled. It is stored and runs automatically once the funds reach the buyer's wallet; the escrow cannot be released meanwhile.",
  "type": "object",
  "additionalProperties": true,
  "required": ["escrowId", "orderId", "buyerUserId", "sellerUserId", "pendingRefund"],
  "properties": {
    "escrowId": { "type": "string" },
    "orderId": { "type": "string" },
    "orderNumber": { "type": "string" },
    "buyerUserId": { "type": "string" },
    "sellerUserId": { "type": "string" },
    "status": { "type": "string" },
    "reason": { "type": "string" },
    "pendingRefund": {
      "type": "object",
      "required": ["id", "amountMinor", "currency", "full"],
      "properties": {
        "id": { "type": "string" },
        "amountMinor": { "type": "integer", "minimum": 1 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "full": { "type": "boolean" }
      }
    }
  }
}
