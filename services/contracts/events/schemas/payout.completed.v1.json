{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/payout.completed.v1.json",
  "title": "PayoutCompleted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "withdrawalId",
    "userId",
    "status",
    "reference",
    "amount",
    "fee"
  ],
  "properties": {
    "withdrawalId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
