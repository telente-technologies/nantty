{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/liveSafety.resumed.v1.json",
  "title": "liveSafety.resumed (go-live; realtime fans out to live:{liveId})",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "liveId",
    "state",
    "message",
    "at"
  ],
  "properties": {
    "liveId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "paused",
        "live"
      ]
    },
    "message": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
