{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/orderGroup.paid.v1.json",
  "title": "OrderGroupPaid",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderGroupId",
    "orderNumber",
    "orderedAt",
    "checkoutId",
    "storeId",
    "sellerAccountId",
    "buyerAccountId",
    "subtotalMinor",
    "totalMinor",
    "currency",
    "attributedItems"
  ],
  "properties": {
    "orderGroupId": {
      "type": "string"
    },
    "orderNumber": {
      "type": "string"
    },
    "orderedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checkoutId": {
      "type": "string"
    },
    "storeId": {
      "type": "string"
    },
    "sellerAccountId": {
      "type": "string"
    },
    "buyerAccountId": {
      "type": "string"
    },
    "subtotalMinor": {
      "type": "integer"
    },
    "totalMinor": {
      "type": "integer"
    },
    "currency": {
      "type": "string"
    },
    "attributedItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attributedItem"
      }
    },
    "sellerName": {
      "type": "string"
    },
    "buyerName": {
      "type": "string"
    },
    "paymentMode": {
      "type": "string"
    },
    "discountMinor": {
      "type": "integer"
    },
    "storeCreditMinor": {
      "type": "integer"
    },
    "shippingMinor": {
      "type": "integer"
    },
    "refundedMinor": {
      "type": "integer"
    },
    "shippingMethod": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "./orderGroup.item.v1.json"
      }
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    },
    "paymentMethod": {
      "type": "string"
    }
  },
  "$defs": {
    "attributedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderItemId",
        "productId",
        "variantId",
        "quantity",
        "lineTotalMinor",
        "currency",
        "attributionSource",
        "attributionId",
        "attributedAt",
        "commissionBasisPoints"
      ],
      "properties": {
        "orderItemId": {
          "type": "string"
        },
        "productId": {
          "type": "string"
        },
        "variantId": {
          "type": "string"
        },
        "quantity": {
          "type": "integer"
        },
        "lineTotalMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "attributionSource": {
          "type": "string"
        },
        "attributionId": {
          "type": "string"
        },
        "attributedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "commissionBasisPoints": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
