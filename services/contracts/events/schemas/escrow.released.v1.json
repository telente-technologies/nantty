{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/escrow.released.v1.json",
  "title": "EscrowReleased",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "escrowId",
    "orderId",
    "checkoutId",
    "storeId",
    "buyerUserId",
    "sellerUserId",
    "status",
    "amount",
    "commission",
    "refunded",
    "releasedToSeller",
    "orderNumber",
    "refundBreakdown"
  ],
  "properties": {
    "escrowId": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "checkoutId": {
      "type": "string"
    },
    "storeId": {
      "type": "string"
    },
    "buyerUserId": {
      "type": "string"
    },
    "sellerUserId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "commission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "refunded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "releasedToSeller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "orderNumber": {
      "type": "string"
    },
    "processingFee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "refundBreakdown": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["amountMinor", "currency"],
            "properties": {
              "amountMinor": { "type": "integer" },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
            }
          }
        }
      ]
    }
  }
}
