{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/message.sent.v1.json",
  "title": "MessageSent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversationId",
    "messageId",
    "senderId",
    "kind",
    "recipientIds",
    "sentAt"
  ],
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid"
    },
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "senderId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string"
    },
    "recipientIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "isNewConversation": {
      "type": "boolean"
    },
    "inboxFolderByRecipient": {
      "type": "object"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "conversationKind": {
      "type": "string",
      "enum": [
        "direct",
        "group",
        "channel",
        "business"
      ]
    },
    "conversationTitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "senderName": {
      "type": "string"
    },
    "pushRecipients": {
      "type": "array",
      "description": "Recipients to push to: in their chats folder, chat not muted, chat pushes on. Never carries message content.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userId",
          "showPreview"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "showPreview": {
            "type": "boolean"
          },
          "sound": {
            "type": "boolean",
            "description": "Whether this device should use its configured message notification sound."
          },
          "vibration": {
            "type": "boolean",
            "description": "Whether this device should vibrate for this message notification."
          },
          "bubbleAllowed": {
            "type": "boolean",
            "description": "Whether this recipient's saved conversation and device preferences permit an Android system bubble."
          }
        }
      }
    }
  }
}
