{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/subscriptionOffer.sent.v1.json",
  "title": "subscriptionOffer.sent",
  "description": "Staff emailed a subscription discount link. The recipient may not have a Nantty account; claimUrl carries the link token, so consumers must not log it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sendId", "linkId", "recipientEmail", "note", "claimUrl", "discountKind", "plans", "durationCycles", "expiresAt", "singleUse", "sentByStaffId"],
  "properties": {
    "sendId": { "type": "string" },
    "linkId": { "type": "string" },
    "recipientEmail": { "type": "string", "format": "email", "maxLength": 254 },
    "note": { "type": "string", "maxLength": 500 },
    "claimUrl": { "type": "string", "format": "uri" },
    "discountKind": { "type": "string", "enum": ["percentage", "fixed_amount"] },
    "percentOff": { "type": "integer", "minimum": 1, "maximum": 100 },
    "amountOff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amountMinor", "currency"],
      "properties": { "amountMinor": { "type": "integer", "minimum": 1 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["planCode", "planLabel"],
        "properties": { "planCode": { "type": "string" }, "planLabel": { "type": "string" } }
      }
    },
    "durationCycles": { "type": "integer", "minimum": 1 },
    "expiresAt": { "type": "string", "description": "RFC 3339 time, or empty when the link never expires" },
    "singleUse": { "type": "boolean" },
    "sentByStaffId": { "type": "string" }
  }
}
