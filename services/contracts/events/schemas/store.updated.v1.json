{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/store.updated.v1.json",
  "title": "StoreUpdated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storeId"
  ],
  "properties": {
    "storeId": {
      "type": "string"
    },
    "moderationVisibility": {
      "enum": [
        "visible",
        "restricted",
        "hidden",
        "removed"
      ]
    },
    "featuredProductIds": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
