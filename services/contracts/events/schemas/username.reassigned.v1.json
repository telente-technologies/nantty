{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/username.reassigned.v1.json",
  "title": "UsernameReassigned",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "username",
    "fromAccountId",
    "fromNewUsername",
    "toAccountId",
    "toPreviousUsername",
    "reason"
  ],
  "properties": {
    "username": {
      "type": "string"
    },
    "fromAccountId": {
      "type": "string",
      "format": "uuid"
    },
    "fromNewUsername": {
      "type": "string"
    },
    "toAccountId": {
      "type": "string",
      "format": "uuid"
    },
    "toPreviousUsername": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  }
}
