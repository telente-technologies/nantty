{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/verificationLevel.changed.v1.json",
  "title": "VerificationLevelChanged",
  "description": "A user's verification level changed. 0 = email only, 1 = payout-verified (withdrawals, creator cash, ads), 2 = identity-verified through the configured identity-verification product. Required checks vary by product and may include photo-document, liveness, face-match, or ID-number authority checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "level",
    "previousLevel",
    "payoutVerified",
    "identityVerified",
    "country"
  ],
  "properties": {
    "userId": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "previousLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "payoutVerified": {
      "type": "boolean"
    },
    "identityVerified": {
      "type": "boolean"
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "method": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "bank_account",
        "payout_account",
        "smile_id",
        null
      ]
    }
  }
}
