{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/product.purchased.v1.json",
  "title": "ProductPurchased",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "occurredAt",
    "productId",
    "storeId",
    "variantId",
    "quantity",
    "personalized",
    "orderGroupId"
  ],
  "properties": {
    "occurredAt": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "storeId": {
      "type": "string"
    },
    "categoryId": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "position": {
      "type": "integer"
    },
    "resultCount": {
      "type": "integer"
    },
    "variantId": {
      "type": "string"
    },
    "personalized": {
      "type": "boolean"
    },
    "actorId": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "quantity": {
      "type": "integer"
    },
    "orderGroupId": {
      "type": "string"
    },
    "unitPrice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "sourcePostId": {
      "type": "string"
    }
  }
}
