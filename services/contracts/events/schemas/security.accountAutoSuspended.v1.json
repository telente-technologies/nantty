{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/security.accountAutoSuspended.v1.json",
  "title": "AccountAutoSuspended",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "caseId",
    "reason",
    "durationDays",
    "appealable"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "caseId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string"
    },
    "durationDays": {
      "type": "integer",
      "minimum": 1
    },
    "appealable": {
      "const": true
    }
  }
}
