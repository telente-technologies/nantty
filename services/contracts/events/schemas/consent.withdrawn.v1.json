{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/consent.withdrawn.v1.json",
  "title": "ConsentWithdrawn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "consentType",
    "policyVersion",
    "occurredAt"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "consentType": {
      "enum": [
        "analytics",
        "personalization",
        "advertising",
        "marketing"
      ]
    },
    "policyVersion": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
