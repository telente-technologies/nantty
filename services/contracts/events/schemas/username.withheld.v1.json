{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/username.withheld.v1.json",
  "title": "UsernameWithheld",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "username",
    "reason"
  ],
  "properties": {
    "username": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "assignedUsername": {
      "type": "string"
    }
  }
}
