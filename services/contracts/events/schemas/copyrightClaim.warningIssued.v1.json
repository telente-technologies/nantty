{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/copyrightClaim.warningIssued.v1.json",
  "title": "CopyrightClaimWarningIssued",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimId",
    "targetType",
    "targetId",
    "infringerId",
    "workTitle",
    "reason",
    "canSubmitCounterNotice",
    "deadlineAt",
    "warningId"
  ],
  "properties": {
    "claimId": {
      "type": "string",
      "format": "uuid"
    },
    "targetType": {
      "enum": [
        "clip",
        "sound",
        "post",
        "live"
      ]
    },
    "targetId": {
      "type": "string"
    },
    "infringerId": {
      "type": "string"
    },
    "workTitle": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "warningId": {
      "type": "string",
      "format": "uuid"
    },
    "strikeId": {
      "type": "string",
      "format": "uuid"
    },
    "canSubmitCounterNotice": {
      "type": "boolean"
    }
  }
}
