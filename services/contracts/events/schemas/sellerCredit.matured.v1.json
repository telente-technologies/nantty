{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/sellerCredit.matured.v1.json",
  "title": "SellerCreditMatured",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sellerUserId",
    "sourceReference",
    "debtRepaidMinor",
    "amount"
  ],
  "properties": {
    "sellerUserId": {
      "type": "string"
    },
    "sourceReference": {
      "type": "string"
    },
    "debtRepaidMinor": {
      "type": "integer"
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
