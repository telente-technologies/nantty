{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zudomart.com/events/payoutAccount.defaultChanged.v1.json",
  "title": "PayoutAccountDefaultChanged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payoutAccountId",
    "userId",
    "withdrawableFrom"
  ],
  "properties": {
    "payoutAccountId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "bankName": {
      "type": "string"
    },
    "accountNumberLast4": {
      "type": "string",
      "pattern": "^[0-9]{0,4}$"
    },
    "withdrawableFrom": {
      "type": "string",
      "format": "date-time"
    }
  }
}
