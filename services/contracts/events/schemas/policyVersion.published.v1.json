{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/policyVersion.published.v1.json",
  "title": "PolicyVersionPublished",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "effectiveAt",
    "publishedBy"
  ],
  "properties": {
    "kind": {
      "enum": [
        "privacy_policy",
        "cookie_policy",
        "terms",
        "community-guidelines",
        "seller-terms",
        "creator-terms",
        "ads-policy",
        "refund-escrow-policy"
      ]
    },
    "version": {
      "type": "string"
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "publishedBy": {
      "type": "string"
    },
    "versionId": {
      "type": "string",
      "format": "uuid"
    },
    "documentKey": {
      "type": "string"
    },
    "documentTitle": {
      "type": "string"
    },
    "changeSummary": {
      "type": "string"
    },
    "whatChanged": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isMaterialChange": {
      "type": "boolean"
    }
  }
}
