{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/orderGroup.created.v1.json",
  "title": "OrderGroupCreated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderGroupId",
    "checkoutId",
    "storeId",
    "buyerAccountId",
    "sellerAccountId",
    "orderNumber",
    "totalMinor",
    "currency"
  ],
  "properties": {
    "orderGroupId": {
      "type": "string"
    },
    "checkoutId": {
      "type": "string"
    },
    "storeId": {
      "type": "string"
    },
    "buyerAccountId": {
      "type": "string"
    },
    "sellerAccountId": {
      "type": "string"
    },
    "orderNumber": {
      "type": "string"
    },
    "totalMinor": {
      "type": "integer"
    },
    "currency": {
      "type": "string"
    },
    "sellerName": {
      "type": "string"
    },
    "buyerName": {
      "type": "string"
    },
    "paymentMode": {
      "type": "string"
    },
    "subtotalMinor": {
      "type": "integer"
    },
    "discountMinor": {
      "type": "integer"
    },
    "storeCreditMinor": {
      "type": "integer"
    },
    "shippingMinor": {
      "type": "integer"
    },
    "refundedMinor": {
      "type": "integer"
    },
    "shippingMethod": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "./orderGroup.item.v1.json"
      }
    },
    "payBy": {
      "type": "string",
      "format": "date-time"
    }
  }
}
