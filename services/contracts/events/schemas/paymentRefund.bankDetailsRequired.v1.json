{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nantty.com/events/paymentRefund.bankDetailsRequired.v1.json",
  "title": "paymentRefund.bankDetailsRequired",
  "description": "The payment provider needs the buyer's bank account to return a bank-transfer payment (refund needs-attention).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "refundId",
    "paymentIntentId",
    "reference",
    "amount",
    "ownerUserId"
  ],
  "properties": {
    "refundId": {
      "type": "string"
    },
    "paymentIntentId": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "ownerUserId": {
      "type": "string"
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        }
      }
    }
  }
}
