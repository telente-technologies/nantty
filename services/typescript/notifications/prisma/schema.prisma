generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  dedupeKey  String    @unique
  category   String
  kind       String?
  templateKey String?
  title      String
  body       String
  actor      Json?
  data       Json      @default("{}")
  readAt     DateTime?
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc), id])
  @@index([userId, readAt])
  @@index([userId, kind, createdAt(sort: Desc)])
  @@map("notifications")
}

model Delivery {
  id                String   @id @default(uuid())
  dedupeKey         String   @unique
  eventId           String
  userId            String?
  channel           String
  templateKey       String?
  mailKind          String?
  status            String
  attemptCount      Int      @default(0)
  lastAttemptAt     DateTime?
  failedAt          DateTime?
  skipReason        String?
  providerMessageId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, channel, mailKind, status, createdAt])
  @@index([eventId])
  @@index([providerMessageId])
  @@map("deliveries")
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  category  String
  push      Boolean  @default(true)
  email     Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@map("notification_preferences")
}

model ActivityHeartbeat {
  accountId                   String                 @id @map("account_id") @db.Uuid
  lastActivityAt              DateTime               @map("last_activity_at")
  timeZone                    String                 @map("time_zone") @db.VarChar(64)
  lastReengagementAttemptAt   DateTime?              @map("last_reengagement_attempt_at")
  createdAt                   DateTime               @default(now()) @map("created_at")
  updatedAt                   DateTime               @updatedAt @map("updated_at")
  reengagementDeliveries      ReengagementDelivery[]

  @@index([lastActivityAt, lastReengagementAttemptAt])
  @@map("activity_heartbeats")
}

model ReengagementDelivery {
  id              String           @id @default(uuid()) @db.Uuid
  accountId       String           @map("account_id") @db.Uuid
  campaignId      String           @map("campaign_id") @db.VarChar(80)
  contentKey      String           @map("content_key") @db.VarChar(120)
  dedupeKey       String           @unique @map("dedupe_key") @db.VarChar(240)
  activityAt      DateTime         @map("activity_at")
  status          String           @default("pending") @db.VarChar(20)
  outcomeReason   String?          @map("outcome_reason") @db.VarChar(200)
  queueLeaseUntil DateTime?        @map("queue_lease_until")
  queueLockToken  String?          @map("queue_lock_token") @db.Uuid
  sentAt          DateTime?        @map("sent_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  activity        ActivityHeartbeat @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@unique([accountId, campaignId, contentKey])
  @@index([status, queueLeaseUntil, createdAt])
  @@map("reengagement_deliveries")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  provider  String   @default("expo")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}

model EmailSuppression {
  email     String   @id
  reason    String
  source    String
  createdAt DateTime @default(now())

  @@index([reason])
  @@map("email_suppressions")
}

model UnsubscribeReceipt {
  tokenHash String   @id
  accountId String
  usedAt    DateTime @default(now())

  @@index([accountId])
  @@map("unsubscribe_receipts")
}

model BulkCampaign {
  id                       String    @id @default(uuid())
  kind                     String
  status                   String
  subject                  String
  payload                  Json
  audienceKind             String
  audienceLabel            String
  audienceRef              String
  mailKind                 String
  recipientCount           Int       @default(0)
  sentCount                Int       @default(0)
  skippedNoMarketingConsent Int      @default(0)
  skippedHardBounces       Int       @default(0)
  skippedSuppressed        Int       @default(0)
  failedCount              Int       @default(0)
  batchSize                Int
  ratePerSecond            Int
  batchesTotal             Int       @default(0)
  batchesDone              Int       @default(0)
  nextCursor               String?
  reason                   String?
  queuedById               String
  queuedByName             String
  versionId                String?
  createdAt                DateTime  @default(now())
  completedAt              DateTime?

  @@index([kind, createdAt(sort: Desc)])
  @@index([versionId, status])
  @@map("bulk_campaigns")
}

model NoticeDraft {
  versionId     String   @id
  documentKey   String
  documentTitle String
  versionNumber Int      @default(1)
  subject       String
  summaryText   String
  whatChanged   Json     @default("[]")
  effectiveAt   DateTime
  reacceptNote  String?
  documentUrl   String
  requiresReacceptance Boolean @default(false)
  updatedByName String?
  updatedAt     DateTime @default(now()) @updatedAt
  testSends     Json     @default("[]")

  @@map("notice_drafts")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  eventType   String    @map("event_type")
  subject     String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  lockedUntil DateTime? @map("locked_until")
  lockToken   String?   @map("lock_token")
  attempts    Int       @default(0)
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
