{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*", "prisma.config.ts", "../../../packages/emailTemplates/src/**/*"]
}
