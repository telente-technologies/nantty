{
  "name": "@nantty/search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "prisma generate && node ../../../scripts/stripGeneratedPrismaImports.mjs src/generated/prisma && tsc --noEmit",
    "typecheck": "prisma generate && node ../../../scripts/stripGeneratedPrismaImports.mjs src/generated/prisma && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "prisma generate && node ../../../scripts/stripGeneratedPrismaImports.mjs src/generated/prisma && vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "db:generate": "prisma generate && node ../../../scripts/stripGeneratedPrismaImports.mjs src/generated/prisma",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint -c ../../../packages/eslintConfig/node.config.mjs src"
  },
  "dependencies": {
    "@nantty/fastify-platform": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-amqplib": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqplib": "^2.4.1",
    "fastify": "5.12.8",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@nantty/eslint-config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
