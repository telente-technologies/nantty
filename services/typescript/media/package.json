{
  "name": "@zudomart/media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "prisma generate && vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint -c ../../../packages/eslintConfig/node.config.mjs src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@zudojs/http": "^1.5.0",
    "@zudojs/logger": "^1.5.0",
    "@zudojs/schema": "^1.3.0",
    "amqplib": "^2.2.0",
    "blurhash": "^2.0.5",
    "prisma": "^7.10.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@zudomart/eslint-config": "workspace:*",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
