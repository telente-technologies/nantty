HOST=0.0.0.0
PORT=8108
DATABASE_URL=postgres://svc_media:svc_media_local_only@localhost:15432/nantty?schema=media
EVENT_BUS=rabbitmq
RABBITMQ_URL=amqp://media:media-local-only@localhost:5672/nantty
MEDIA_INTERNAL_TOKEN=local-only-media-internal-token-0123456789
JOBS_ENABLED=true
WORKER_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=500
SWEEP_INTERVAL_MS=900000
UPLOAD_CHUNK_SIZE_BYTES=8388608
S3_REGION=eu-west-1
S3_ENDPOINT=http://localhost:18333
S3_PUBLIC_ENDPOINT=http://localhost:18333
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local-only
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKETS=true
MEDIA_QUARANTINE_BUCKET=nantty-media-quarantine
MEDIA_PUBLIC_BUCKET=nantty-media-public
MEDIA_PRIVATE_BUCKET=nantty-media-private
MEDIA_PRIVATE_KMS_KEY_ID=
CDN_BASE_URL=
CDN_PRIVATE_BASE_URL=
CDN_SIGNING_KEY_PAIR_ID=
CDN_SIGNING_PRIVATE_KEY=
CDN_SIGNED_URL_LIFETIME_SECONDS=3600
CLAMAV_HOST=
CLAMAV_PORT=3310
# Local development only: publish uploads when ClamAV is not running. Never enable outside local/test.
MEDIA_ALLOW_UNSCANNED=true
FFMPEG_MODE=auto
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_MAXIMUM_HEIGHT=720
MODERATION_URL=http://localhost:8090
MODERATION_TOKEN=local-only-intelligence-shared-secret-0123456789
MODERATION_FAIL_MODE=allow
MODERATION_HOLD_THRESHOLD=0.5
MODERATION_REJECT_THRESHOLD=0.97
ALLOW_PROXIED_CHUNKS=true
HEIF_CONVERT_PATH=heif-convert
GATEWAY_IDENTITY_SECRET=local-only-gateway-identity-secret-0123456789
