enum PostKind {
  post
  clip
  story
}

enum PostAudience {
  everyone
  followers
}

enum PostVisibility {
  public
  subscribers
}

enum MediaKind {
  image
  video
}

enum ModerationVisibility {
  visible
  restricted
  hidden
  removed
}

enum MediaProcessingStatus {
  processing
  ready
  failed
}

enum ReplyPolicy {
  everyone
  following
  followers
  mentioned
  off
}

enum SensitiveLabel {
  nudity
  graphic_violence
  dangerous_acts
  self_harm
}

model Post {
  id                 String         @id @default(uuid(7)) @db.Uuid
  authorId           String         @db.Uuid
  authorProfileId    String?        @db.Uuid
  authorProfileKind  String?
  kind               PostKind
  text               String         @default("")
  audience           PostAudience   @default(everyone)
  visibility         PostVisibility @default(public)
  isAiGenerated      Boolean        @default(false)
  soundId            String?        @db.Uuid
  resharedFromId     String?        @db.Uuid
  replyToCommentId   String?        @db.Uuid
  replyToClipId      String?        @db.Uuid
  replyToCommenterId String?        @db.Uuid
  stickerLayout      Json?
  mentions           Json           @default("[]")
  linkPreview        Json?
  likeCount          Int            @default(0)
  commentCount       Int            @default(0)
  repostCount        Int            @default(0)
  shareCount         Int            @default(0)
  viewCount          Int            @default(0)
  profileVisitCount  Int            @default(0)
  saveCount          Int            @default(0)
  quoteCount         Int            @default(0)
  isQuote            Boolean        @default(false)
  replyPolicy        ReplyPolicy    @default(everyone)
  sensitiveLabels           SensitiveLabel[] @default([])
  authorSensitiveLabels     SensitiveLabel[] @default([])
  moderationSensitiveLabels SensitiveLabel[] @default([])
  advisorySensitiveLabels   SensitiveLabel[] @default([])
  sensitiveLabelsReviewed   Boolean          @default(false)
  moderationVisibility ModerationVisibility @default(visible)
  moderationVisibilityAt DateTime?
  topics             String[]       @default([])
  productIds         String[]       @default([])
  clipEdit           Json?
  location           Json?
  expiresAt          DateTime?
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  isPinned           Boolean        @default(false)
  pinnedAt           DateTime?
  pinnedCommentId    String?        @db.Uuid

  media      PostMedia[]
  comments   Comment[]
  likes      PostLike[]
  tags       PostTag[]
  resharedFrom Post?  @relation("Reshares", fields: [resharedFromId], references: [id])
  reshares   Post[]   @relation("Reshares")

  @@index([authorId, id])
  @@index([kind, id])
  @@index([kind, createdAt, likeCount])
  @@index([resharedFromId])
  @@index([resharedFromId, isQuote, id])
  @@index([replyToCommentId])
  @@index([authorId, isPinned])
  @@map("posts")
}

model PostMedia {
  id              String    @id @default(uuid(7)) @db.Uuid
  postId          String    @db.Uuid
  mediaId         String    @db.Uuid
  position        Int
  type            MediaKind
  url             String?
  posterUrl       String?
  hlsUrl          String?
  width           Int?
  height          Int?
  durationSeconds Int?
  blurhash        String?
  status          MediaProcessingStatus @default(ready)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@index([mediaId])
  @@map("post_media")
}

model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_likes")
}

model PostShare {
  id        String   @id @default(uuid(7)) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  channel   String   @default("link")
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("post_shares")
}

model Comment {
  id               String    @id @default(uuid(7)) @db.Uuid
  postId           String    @db.Uuid
  parentCommentId  String?   @db.Uuid
  rootCommentId    String?   @db.Uuid
  authorId         String    @db.Uuid
  text             String
  mentions         Json      @default("[]")
  likeCount        Int       @default(0)
  replyCount       Int       @default(0)
  depth            Int       @default(0)
  path             String    @default("")
  moderationVisibility ModerationVisibility @default(visible)
  moderationVisibilityAt DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  isPinned         Boolean   @default(false)
  pinnedAt         DateTime?
  quotedPostId     String?   @db.Uuid

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes   CommentLike[]

  @@index([postId, parentCommentId, id])
  @@index([postId, isPinned])
  @@index([rootCommentId, id])
  @@index([rootCommentId, path])
  @@index([authorId])
  @@index([quotedPostId])
  @@map("comments")
}

model CommentLike {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("comment_likes")
}

model FeedFeedback {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([postId])
  @@map("feed_feedback")
}

model StoryView {
  storyId   String   @db.Uuid
  viewerId  String   @db.Uuid
  createdAt DateTime @default(now())

  @@id([storyId, viewerId])
  @@map("story_views")
}

model PostViewer {
  postId             String    @db.Uuid
  viewerKey          String
  createdAt          DateTime  @default(now())
  lastViewedAt       DateTime?
  lastWatchedAt      DateTime?
  lastLinkClickAt    DateTime?
  lastProfileClickAt DateTime?
  followAttributedAt DateTime?

  @@id([postId, viewerKey])
  @@map("post_viewers")
}

model PostDailyStat {
  postId      String @db.Uuid
  day         String
  impressions Int    @default(0)
  videoViews  Int    @default(0)
  watchTimeSeconds Int @default(0)
  completedViews Int @default(0)
  linkClicks  Int    @default(0)
  newFollows  Int    @default(0)

  @@id([postId, day])
  @@map("post_daily_stats")
}

enum SoundStatus {
  available
  under_copyright_review
  removed
}

model Sound {
  id           String      @id @default(uuid(7)) @db.Uuid
  ownerId      String      @db.Uuid
  title        String
  isOriginal   Boolean     @default(true)
  allowReuse   Boolean     @default(true)
  status       SoundStatus @default(available)
  usageCount   Int         @default(0)
  audioUrl     String?
  coverUrl     String?
  sourceClipId String?     @db.Uuid
  createdAt    DateTime    @default(now())

  saves SoundSave[]

  @@index([ownerId])
  @@index([status, usageCount])
  @@map("sounds")
}

model SoundSave {
  soundId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  sound Sound @relation(fields: [soundId], references: [id], onDelete: Cascade)

  @@id([soundId, userId])
  @@index([userId, createdAt])
  @@map("sound_saves")
}

model ContentPreference {
  accountId                   String   @id @db.Uuid
  showSensitiveWithoutWarning Boolean  @default(false)
  updatedAt                   DateTime @default(now()) @updatedAt

  @@map("content_preferences")
}

model CommentRankSnapshot {
  id              String   @id @default(uuid(7)) @db.Uuid
  postId          String   @db.Uuid
  viewerId        String?  @db.Uuid
  pinnedCommentId String?  @db.Uuid
  commentIds      String[] @default([])
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("comment_rank_snapshots")
}

model FeedRankSnapshot {
  id          String   @id @default(uuid(7)) @db.Uuid
  viewerId    String?  @db.Uuid
  surface     String
  itemIds     String[] @default([])
  disclosures Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("feed_rank_snapshots")
}

model PostNotificationMute {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@map("post_notification_mutes")
}
