enum ConversationKind {
  direct
  group
  channel
  business
}

enum MemberRole {
  owner
  admin
  member
  subscriber
}

enum InboxFolder {
  chats
  requests
  spam
}

enum MessageKind {
  text
  voice
  image
  video
  system
  shared
  location
  liveLocation
  document
  poll
  control
}

enum MessageRequestAudience {
  everyone
  following
  followers
  nobody
}

enum GroupInvitationStatus {
  pending
  accepted
  declined
  revoked
  expired
}

enum ChannelInvitationStatus {
  pending
  accepted
  declined
  expired
}

model Conversation {
  id                           String           @id @default(uuid(7)) @db.Uuid
  kind                         ConversationKind
  directKey                    String?          @unique
  title                        String?
  description                  String?
  encryptedAttributes          String?
  photoMediaId                 String?          @db.Uuid
  createdById                  String           @db.Uuid
  storeId                      String?
  orderId                      String?          @db.Uuid
  orderNumber                  String?
  disappearingMessagesSeconds  Int?
  onlyAdminsCanMentionAll      Boolean          @default(false)
  lastMessageKind              MessageKind?
  lastMessageAt                DateTime         @default(now())
  createdAt                    DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]
  groupInvitations GroupMembershipInvitation[]
  groupInvitationLinks GroupInvitationLink[]
  channelInvitations ChannelInvitation[]
  channelInvitationLinks ChannelInvitationLink[]
  streak   ChatStreak?

  @@index([lastMessageAt])
  @@index([storeId, lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String      @db.Uuid
  accountId      String      @db.Uuid
  role           MemberRole  @default(member)
  inboxFolder    InboxFolder @default(chats)
  spamReason     String?
  spamScore      Float?
  restricted     Boolean     @default(false)
  mutedUntil     DateTime?
  mutedAlways    Boolean     @default(false)
  unreadCount    Int         @default(0)
  lastReadAt     DateTime?
  joinedAt       DateTime    @default(now())
  leftAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, accountId])
  @@index([accountId, inboxFolder, leftAt])
  @@map("conversation_members")
}

model Message {
  id               String      @id @default(uuid(7)) @db.Uuid
  conversationId   String      @db.Uuid
  senderId         String      @db.Uuid
  kind             MessageKind
  clientMessageId  String?
  clientPayloadHash String?    @db.Char(64)
  ciphertext       String?
  deviceId         String?
  protocol         String      @default("signal-v1")
  mediaId          String?     @db.Uuid
  mediaType        String?
  mediaUrl         String?
  mediaStatus      MediaProcessingStatus?
  mediaDurationSeconds Int?
  linkPreviewEnvelope  String?
  mentions         Json        @default("[]")
  expiresAt        DateTime?
  mediaExpiresAt   DateTime?
  mediaPurgedAt    DateTime?
  hiddenAt         DateTime?
  createdAt        DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderLabel  String?

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, id])
  @@index([mediaExpiresAt, mediaPurgedAt])
  @@index([mediaId])
  @@index([expiresAt])
  @@map("messages")
}

model ChatSettings {
  accountId             String                 @id @db.Uuid
  messageRequestsFrom   MessageRequestAudience @default(everyone)
  notifyMessages        Boolean                @default(true)
  notifyRequests        Boolean                @default(true)
  notifyGroups          Boolean                @default(true)
  notifyStreakReminders Boolean                @default(true)
  showMessagePreview    Boolean                @default(true)
  notifyMessageSound   Boolean                @default(true)
  notifyMessageVibration Boolean              @default(true)
  notifyMessageBubbles Boolean               @default(false)
  messageBubbleMode    String                 @default("selected") @db.VarChar(12)
  messageBubbleConversationIds String[]       @default([])
  messageBubbleExcludedConversationIds String[] @default([])
  preventDirectGroupAdds Boolean               @default(false)
  timezone              String                 @default("UTC")
  timezoneChangedAt     DateTime?
  updatedAt             DateTime               @updatedAt

  @@map("chat_settings")
}

model GroupMembershipInvitation {
  id             String                @id @default(uuid(7)) @db.Uuid
  conversationId String                @db.Uuid
  inviterId      String                @db.Uuid
  inviteeId      String                @db.Uuid
  status         GroupInvitationStatus @default(pending)
  createdAt      DateTime              @default(now())
  expiresAt      DateTime
  respondedAt    DateTime?
  updatedAt      DateTime              @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status, createdAt, id])
  @@index([inviterId, status, createdAt, id])
  @@unique([conversationId, inviteeId])
  @@map("group_membership_invitations")
}

model GroupInvitationLink {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @db.Uuid
  createdById    String       @db.Uuid
  tokenHash      String       @unique
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, revokedAt, expiresAt])
  @@index([createdById, createdAt])
  @@map("group_invitation_links")
}

model ChannelInvitation {
  id             String                  @id @default(uuid(7)) @db.Uuid
  conversationId String                  @db.Uuid
  inviterId      String                  @db.Uuid
  inviteeId      String                  @db.Uuid
  status         ChannelInvitationStatus @default(pending)
  createdAt      DateTime                @default(now())
  expiresAt      DateTime
  respondedAt    DateTime?
  updatedAt      DateTime                @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, inviteeId])
  @@index([inviteeId, status, createdAt, id])
  @@index([conversationId, inviteeId, status])
  @@map("channel_invitations")
}

model ChannelInvitationLink {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @db.Uuid
  createdById    String   @db.Uuid
  tokenHash      String   @unique
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, revokedAt, expiresAt])
  @@index([createdById, createdAt])
  @@map("channel_invitation_links")
}

model SenderBehaviourMetric {
  accountId          String   @id @db.Uuid
  windowStartedAt    DateTime @default(now())
  recipientsInWindow Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@map("sender_behaviour_metrics")
}

model ChatMediaExpiryRun {
  id          String   @id @default(uuid(7)) @db.Uuid
  purgedCount Int
  ranAt       DateTime @default(now())

  @@map("chat_media_expiry_runs")
}
