model LinkPreviewCache {
  normalizedUrl String   @id
  url           String
  status        String
  title         String?
  description   String?
  siteName      String?
  imageUrl      String?
  imageMediaId  String?  @db.Uuid
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
  @@map("link_preview_cache")
}
