{
  "name": "@zudomart/social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && prisma generate --schema prisma/identityRead && tsc",
    "typecheck": "prisma generate && prisma generate --schema prisma/identityRead && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "prisma generate && prisma generate --schema prisma/identityRead && vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "db:generate": "prisma generate && prisma generate --schema prisma/identityRead",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint -c ../../../packages/eslintConfig/node.config.mjs src"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "3.1152.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-amqplib": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@zudojs/http": "^1.5.0",
    "@zudojs/logger": "^1.5.0",
    "@zudojs/schema": "^1.3.0",
    "amqplib": "^2.2.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@zudomart/eslint-config": "workspace:*",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
