{
  "name": "@nantty/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint -c ../../../packages/eslintConfig/node.config.mjs src"
  },
  "dependencies": {
    "@nantty/fastify-platform": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "fastify": "5.7.4",
    "@zudojs/http": "^1.5.0",
    "@zudojs/logger": "^1.5.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@nantty/eslint-config": "workspace:*",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
