PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200,http://localhost:3300,http://localhost:3400,http://localhost:3500,http://localhost:3600,http://localhost:8081
AUTH_JWKS_URL=http://localhost:8101/.well-known/jwks.json
AUTH_TOKEN_ISSUER=http://localhost:8101
AUTH_TOKEN_AUDIENCE=nantty-api
UPSTREAM_IDENTITY_URL=http://localhost:8101
RATE_LIMIT_MAX_PER_MINUTE=600
# Initial policy defaults; monitor false positives/abuse during isolated beta before tuning.
AUTHENTICATED_API_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_COUNT=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGINIP_COUNT=20
RATE_LIMIT_LOGINIP_WINDOW_SECONDS=900
RATE_LIMIT_OTP_COUNT=5
RATE_LIMIT_OTP_WINDOW_SECONDS=900
RATE_LIMIT_OTPIP_COUNT=30
RATE_LIMIT_OTPIP_WINDOW_SECONDS=900
RATE_LIMIT_OTPSEND_COUNT=3
RATE_LIMIT_OTPSEND_WINDOW_SECONDS=900
RATE_LIMIT_OTPSENDIP_COUNT=20
RATE_LIMIT_OTPSENDIP_WINDOW_SECONDS=900
RATE_LIMIT_RESET_COUNT=3
RATE_LIMIT_RESET_WINDOW_SECONDS=3600
RATE_LIMIT_RESETIP_COUNT=10
RATE_LIMIT_RESETIP_WINDOW_SECONDS=3600
RATE_LIMIT_SIGNUP_COUNT=5
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
RATE_LIMIT_SEARCH_COUNT=30
RATE_LIMIT_UPLOAD_COUNT=10
RATE_LIMIT_WALLETTRANSFER_COUNT=5
UPSTREAM_LIVE_URL=http://localhost:8102
UPSTREAM_MONEY_URL=http://localhost:8103
UPSTREAM_NOTIFICATIONS_URL=http://localhost:8104
UPSTREAM_SOCIAL_URL=http://localhost:8105
IDENTITY_INTERNAL_TOKEN=local-only-users-internal-token-0123456789
UPSTREAM_MEDIA_URL=http://localhost:8108
UPSTREAM_SEARCH_URL=http://localhost:8109
UPSTREAM_ADS_URL=http://localhost:8110
UPSTREAM_SUPPORT_URL=http://localhost:8111
UPSTREAM_TRUST_URL=http://localhost:8106
UPSTREAM_COMMERCE_URL=http://localhost:8107
# Local only: proxies /ws* upgrades to realtime the way the ALB /ws* rule does in AWS. Leave unset in production.
UPSTREAM_REALTIME_URL=http://127.0.0.1:4000
TRUST_INTERNAL_TOKEN=local-only-moderation-internal-token-0123456789
HUMAN_VERIFICATION_PROVIDER=turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
HUMAN_VERIFICATION_HOSTNAMES=
HUMAN_VERIFICATION_ATTEMPTS_PER_MINUTE=10
# Number of proxies in front of the gateway (0 when clients connect directly; 1 behind the ALB). Required in production.
TRUSTED_PROXY_HOPS=0
GATEWAY_IDENTITY_SECRET=local-only-gateway-identity-secret-0123456789
# Comma-separated IPs or CIDR ranges allowed to reach /api/v1/admin/* (empty allows all; set it in production). Mirrors go-identity.
ADMIN_IP_ALLOWLIST=
