HOST=0.0.0.0
PORT=8090
NODE_ENV=development
SANDBOX_DATABASE_URL=postgresql://sandbox_user:replace-me@127.0.0.1:5432/nantty_sandbox
SANDBOX_CONTROL_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Optional until Sandbox webhooks are enabled. Generate a dedicated 32-byte key and base64-encode it.
SANDBOX_WEBHOOK_SECRET_ENCRYPTION_KEY=
# Required in production; must point to the separately managed production database for a fail-closed target comparison.
PRODUCTION_DATABASE_URL=
